{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.dev/schema/kv-cache-default-v1.schema.json",
  "title": "sLLM KV-cache default quality policy v1",
  "description": "Baseline-frozen, target-independent policy consumed by Phase 53. This document deliberately has no self-digest; callers hash its canonical bytes externally.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "policy_id", "scope", "freeze", "thresholds", "failure_rules", "targets"],
  "properties": {
    "$schema": {"const": "https://sllm.dev/schema/kv-cache-default-v1.schema.json"},
    "schema_version": {"const": "kv-cache-default-v1"},
    "policy_id": {"const": "kv-cache-default-v1"},
    "scope": {"$ref": "#/$defs/scope"},
    "freeze": {"$ref": "#/$defs/freeze"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "failure_rules": {"$ref": "#/$defs/failure_rules"},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 1024},
    "lock": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/digest"}}},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["model", "promotion_scope", "unverified_model_default", "allowed_encodings"],
      "properties": {
        "model": {"type": "object", "additionalProperties": false, "required": ["repo_id", "dtype", "model_lock", "derived_lock"], "properties": {"repo_id": {"const": "Qwen/Qwen3.5-4B"}, "dtype": {"const": "BF16"}, "model_lock": {"$ref": "#/$defs/lock"}, "derived_lock": {"$ref": "#/$defs/derived_lock"}}},
        "promotion_scope": {"const": "first-promotion-qwen35-4b-bf16-dense-text-full-attention-single-gpu"},
        "unverified_model_default": {"const": "fp16"},
        "allowed_encodings": {"const": ["fp16", "kv-fp8-e4-block16", "kv-fp8-e5-block16"]}
      }
    },
    "derived_lock": {"type": "object", "additionalProperties": false, "required": ["status", "path", "fingerprint"], "properties": {"status": {"const": "required-for-candidate"}, "path": {"type": ["string", "null"], "minLength": 1}, "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["id", "digest", "license", "seed", "sample_order"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "license": {"type": "string", "minLength": 1}, "seed": {"type": "integer", "minimum": 0}, "sample_order": {"const": "listed"}}},
    "freeze": {
      "type": "object", "additionalProperties": false, "required": ["basis", "candidate_excluded", "rationale", "frozen_at", "dataset", "context_matrix", "metrics", "repeats", "baseline_requirements"],
      "properties": {
        "basis": {"const": "fp16-only-baseline"}, "candidate_excluded": {"const": true}, "rationale": {"type": "string", "minLength": 1}, "frozen_at": {"type": "string", "format": "date"}, "dataset": {"$ref": "#/$defs/dataset"},
        "context_matrix": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "metrics": {"const": ["perplexity", "kld", "top1", "task", "long-context"]},
        "repeats": {"type": "object", "additionalProperties": false, "required": ["count", "aggregation", "minimum_completed"], "properties": {"count": {"type": "integer", "minimum": 2}, "aggregation": {"enum": ["mean", "median", "median-mad"]}, "minimum_completed": {"type": "integer", "minimum": 2}}},
        "baseline_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "threshold": {"type": "object", "additionalProperties": false, "required": ["value", "comparison", "unit"], "properties": {"value": {"type": "number", "minimum": 0}, "comparison": {"enum": ["inclusive", "exclusive"]}, "unit": {"type": "string", "minLength": 1}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["perplexity_relative_delta", "kld_p99", "top1_agreement", "task_score_delta", "long_context_score_delta"], "properties": {"perplexity_relative_delta": {"$ref": "#/$defs/threshold"}, "kld_p99": {"$ref": "#/$defs/threshold"}, "top1_agreement": {"$ref": "#/$defs/threshold"}, "task_score_delta": {"$ref": "#/$defs/threshold"}, "long_context_score_delta": {"$ref": "#/$defs/threshold"}}},
    "failure_rules": {
      "type": "object", "additionalProperties": false, "required": ["missing", "nonfinite", "zero_selected", "zero_metric_samples", "reruns", "candidate_freeze"],
      "properties": {
        "missing": {"const": "fail"}, "nonfinite": {"const": "fail"}, "zero_selected": {"const": "fail"}, "zero_metric_samples": {"const": "fail"},
        "reruns": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "on_variance", "same_identity"], "properties": {"minimum": {"type": "integer", "minimum": 2}, "maximum": {"type": "integer", "minimum": 2}, "on_variance": {"enum": ["repeat", "insufficient-evidence"]}, "same_identity": {"const": true}}},
        "candidate_freeze": {"const": "immutable-after-baseline"}
      }
    },
    "decision": {"enum": ["pass", "fail", "missing", "nonfinite", "zero", "unsupported", "insufficient-evidence"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "rocm", "hip", "code_object", "wave", "binary", "kv_descriptor", "provider", "physical_variant", "baseline", "candidate", "decisions", "decision"],
      "properties": {
        "target": {"enum": ["gfx942:sramecc+:xnack-", "gfx1201", "gfx1030"]}, "rocm": {"const": "7.14.0"}, "hip": {"type": "string", "minLength": 1}, "code_object": {"const": "Code Object V6"}, "wave": {"enum": [32, 64]}, "binary": {"anyOf": [{"$ref": "#/$defs/binary"}, {"type": "null"}]}, "kv_descriptor": {"enum": ["kv-fp8-e4-block16-v1", "kv-fp8-e5-block16-v1"]}, "provider": {"type": "string", "minLength": 1}, "physical_variant": {"enum": ["E4M3-FNUZ", "E4M3-OCP", "E5M2-software"]},
        "baseline": {"$ref": "#/$defs/baseline"}, "candidate": {"const": null}, "decisions": {"$ref": "#/$defs/decisions"}, "decision": {"const": "insufficient-evidence"}
      },
      "allOf": [
        {"if": {"properties": {"target": {"const": "gfx942:sramecc+:xnack-"}}}, "then": {"properties": {"wave": {"const": 64}, "kv_descriptor": {"const": "kv-fp8-e4-block16-v1"}, "physical_variant": {"const": "E4M3-FNUZ"}}}},
        {"if": {"properties": {"target": {"const": "gfx1201"}}}, "then": {"properties": {"wave": {"const": 32}, "kv_descriptor": {"const": "kv-fp8-e4-block16-v1"}, "physical_variant": {"const": "E4M3-OCP"}}}},
        {"if": {"properties": {"target": {"const": "gfx1030"}}}, "then": {"properties": {"wave": {"const": 32}, "kv_descriptor": {"const": "kv-fp8-e5-block16-v1"}, "physical_variant": {"const": "E5M2-software"}}}}
      ]
    },
    "binary": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "dataset", "context_matrix", "repeats", "metrics", "evidence"],
      "properties": {
        "status": {"enum": ["required-before-candidate", "frozen"]}, "dataset": {"$ref": "#/$defs/dataset"},
        "context_matrix": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "repeats": {"type": "integer", "minimum": 2}, "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"anyOf": [{"$ref": "#/$defs/baseline_evidence"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "frozen"}}}, "then": {"properties": {"evidence": {"$ref": "#/$defs/baseline_evidence"}}}},
        {"if": {"properties": {"status": {"const": "required-before-candidate"}}}, "then": {"properties": {"evidence": {"type": "null"}}}}
      ]
    },
    "baseline_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["report", "executable", "sample_count", "aggregate_perplexity", "repeat_max_relative_delta", "kld_max", "top1_agreement", "task_score", "task_semantics", "long_context_coverage", "cleanup_empty"],
      "properties": {
        "report": {"$ref": "#/$defs/binary"}, "executable": {"$ref": "#/$defs/binary"},
        "sample_count": {"type": "integer", "minimum": 1}, "aggregate_perplexity": {"type": "number", "minimum": 1},
        "repeat_max_relative_delta": {"type": "number", "minimum": 0}, "kld_max": {"type": "number", "minimum": 0},
        "top1_agreement": {"type": "number", "minimum": 0, "maximum": 1}, "task_score": {"type": "number", "minimum": 0, "maximum": 1},
        "task_semantics": {"const": "synthetic-next-token-correctness"}, "long_context_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "cleanup_empty": {"const": true}
      }
    },
    "decisions": {"type": "object", "additionalProperties": false, "required": ["correctness", "quality", "performance", "memory", "fallback", "cleanup"], "properties": {"correctness": {"$ref": "#/$defs/decision"}, "quality": {"$ref": "#/$defs/decision"}, "performance": {"$ref": "#/$defs/decision"}, "memory": {"$ref": "#/$defs/decision"}, "fallback": {"$ref": "#/$defs/decision"}, "cleanup": {"$ref": "#/$defs/decision"}}}
  }
}
