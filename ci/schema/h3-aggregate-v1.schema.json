{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ullm-project.local/ci/schema/h3-aggregate-v1.schema.json",
  "title": "uLLM Phase 2 H3 compile-only aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id", "target", "state", "report", "report_sha256",
        "report_sidecar_sha256", "metadata_sha256",
        "metadata_sidecar_sha256", "artifact_sha256",
        "artifact_sidecar_sha256"
      ],
      "properties": {
        "row_id": {"enum": ["h3-gfx1030", "h3-gfx1201"]},
        "target": {"enum": ["gfx1030", "gfx1201"]},
        "state": {"const": "PASS"},
        "report": {"const": "report.json"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "report_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sidecar_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "required": [
    "schema_version", "aggregate_id", "state", "required", "evidence_mode",
    "run_id", "run_attempt", "reviewed_sha", "tested_sha", "workflow_sha",
    "expected_rows", "rows", "errors"
  ],
  "properties": {
    "schema_version": {"const": "h3-aggregate-v1"},
    "aggregate_id": {"type": "string", "pattern": "^h3-aggregate\\.[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\.[1-9][0-9]*$"},
    "state": {"enum": ["PASS", "FAIL"]},
    "required": {"const": false},
    "evidence_mode": {"const": "required-ci"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "run_attempt": {"type": "integer", "minimum": 1},
    "reviewed_sha": {"$ref": "#/$defs/sha40"},
    "tested_sha": {"$ref": "#/$defs/sha40"},
    "workflow_sha": {"$ref": "#/$defs/sha40"},
    "git_tree_oid": {"$ref": "#/$defs/sha40"},
    "toolchain_id": {"const": "rocm-7.14.0"},
    "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_id": {"const": "hip-compile-v1"},
    "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "expected_rows": {"const": ["h3-gfx1030", "h3-gfx1201"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_only", "gpu_execution", "execution_attempted", "model_used", "cpu_fallback_used"],
      "properties": {
        "compile_only": {"const": true},
        "gpu_execution": {"const": false},
        "execution_attempted": {"const": false},
        "model_used": {"const": false},
        "cpu_fallback_used": {"const": false}
      }
    },
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}, "maxItems": 2},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PASS"}}},
      "then": {
        "required": ["git_tree_oid", "toolchain_id", "toolchain_manifest_sha256", "matrix_id", "matrix_manifest_sha256", "scope"],
        "properties": {"rows": {"minItems": 2, "maxItems": 2}, "errors": {"maxItems": 0}}
      }
    },
    {
      "if": {"properties": {"state": {"const": "FAIL"}}},
      "then": {"properties": {"errors": {"minItems": 1}}}
    }
  ]
}
