{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.dev/schema/phase46-benchmark-result-v1.schema.json",
  "title": "sLLM Phase 46 benchmark result v1",
  "description": "Identity-bound benchmark aggregate with explicit timing, resource, fallback, and cleanup dispositions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "struct_size", "state", "manifest", "payload", "extensions"],
  "properties": {
    "$schema": {"const": "https://sllm.dev/schema/phase46-benchmark-result-v1.schema.json"},
    "schema_version": {"const": "sllm-phase46-benchmark-result-v1"},
    "struct_size": {"const": 7},
    "state": {"enum": ["PASS", "FAIL", "INSUFFICIENT-EVIDENCE"]},
    "manifest": {"$ref": "#/$defs/manifest"},
    "payload": {"$ref": "#/$defs/payload"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["role", "logical_name", "size_bytes", "sha256"], "properties": {"role": {"type": "string", "minLength": 1, "maxLength": 256}, "logical_name": {"type": "string", "minLength": 1, "maxLength": 256}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "string_map": {"type": "object", "propertyNames": {"minLength": 1, "maxLength": 256}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 16384}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "package", "version", "executable_sha256", "arguments", "environment"], "properties": {"repository": {"type": "string", "minLength": 1, "maxLength": 256}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "package": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 256}, "executable_sha256": {"$ref": "#/$defs/digest"}, "arguments": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 16384}}, "environment": {"$ref": "#/$defs/string_map"}}},
    "recipe": {"type": "object", "additionalProperties": false, "required": ["id", "version", "config_sha256"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 256}, "config_sha256": {"$ref": "#/$defs/digest"}}},
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "struct_size", "canonicalization", "operation", "state", "selected_count", "tool", "recipe", "sources", "outputs", "raw_evidence", "identities", "metrics", "extensions"],
      "properties": {"schema_version": {"const": "sllm-phase46-tool-run-v1"}, "struct_size": {"const": 13}, "canonicalization": {"const": "sllm-sorted-json-v1"}, "operation": {"type": "string", "minLength": 1, "maxLength": 256}, "state": {"enum": ["PASS", "FAIL", "INSUFFICIENT-EVIDENCE"]}, "selected_count": {"type": "integer", "minimum": 1}, "tool": {"$ref": "#/$defs/tool"}, "recipe": {"$ref": "#/$defs/recipe"}, "sources": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/$defs/file"}}, "outputs": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/file"}}, "raw_evidence": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/file"}}, "identities": {"$ref": "#/$defs/string_map"}, "metrics": {"type": "object", "additionalProperties": true}, "extensions": {"type": "object", "additionalProperties": true}}
    },
    "configuration": {"type": "object", "additionalProperties": false, "required": ["request_count", "parallelism", "context_tokens", "sampling", "kv_encoding", "gpu_identity", "provider", "fallback", "cleanup"], "properties": {"request_count": {"type": "integer", "minimum": 1}, "parallelism": {"type": "integer", "minimum": 1}, "context_tokens": {"type": "integer", "minimum": 1}, "sampling": {"type": "string", "minLength": 1}, "kv_encoding": {"type": "string", "minLength": 1}, "gpu_identity": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "fallback": {"type": "boolean"}, "cleanup": {"type": "boolean"}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["iteration", "state", "reason", "wall_ns", "gpu_ns", "model_load_ns", "e2e_ns", "ttft_ns", "tpot_ns", "prefill_ns", "decode_ns"], "properties": {"iteration": {"type": "integer", "minimum": 1}, "state": {"enum": ["PASS", "TIMEOUT", "CRASH", "OOM", "BACKEND_FALLBACK", "CLEANUP_FAILURE", "REJECTED"]}, "reason": {"type": ["string", "null"], "maxLength": 16384}, "wall_ns": {"type": ["integer", "null"], "minimum": 0}, "gpu_ns": {"type": ["integer", "null"], "minimum": 0}, "model_load_ns": {"type": ["integer", "null"], "minimum": 0}, "e2e_ns": {"type": ["integer", "null"], "minimum": 0}, "ttft_ns": {"type": ["integer", "null"], "minimum": 0}, "tpot_ns": {"type": ["integer", "null"], "minimum": 0}, "prefill_ns": {"type": ["integer", "null"], "minimum": 0}, "decode_ns": {"type": ["integer", "null"], "minimum": 0}}},
    "distribution": {"type": "object", "additionalProperties": false, "required": ["count", "min", "p10", "median", "p90", "max", "mad"], "properties": {"count": {"type": "integer", "minimum": 1}, "min": {"type": "integer", "minimum": 1}, "p10": {"type": "integer", "minimum": 1}, "median": {"type": "integer", "minimum": 1}, "p90": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}, "mad": {"type": "integer", "minimum": 0}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["wall_ns", "gpu_ns", "model_load_ns", "e2e_ns", "ttft_ns", "tpot_ns", "prefill_ns", "decode_ns"], "properties": {"wall_ns": {"$ref": "#/$defs/distribution"}, "gpu_ns": {"oneOf": [{"$ref": "#/$defs/distribution"}, {"type": "null"}]}, "model_load_ns": {"$ref": "#/$defs/distribution"}, "e2e_ns": {"$ref": "#/$defs/distribution"}, "ttft_ns": {"$ref": "#/$defs/distribution"}, "tpot_ns": {"$ref": "#/$defs/distribution"}, "prefill_ns": {"$ref": "#/$defs/distribution"}, "decode_ns": {"$ref": "#/$defs/distribution"}}},
    "resource": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status", "bytes"], "properties": {"status": {"const": "measured"}, "bytes": {"type": "integer", "minimum": 0}}}, {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unsupported"}, "reason": {"type": "string", "minLength": 1}}}, {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "missing"}, "reason": {"type": "string", "minLength": 1}}}]},
    "resources": {"type": "object", "additionalProperties": false, "required": ["hbm_before", "hbm_peak", "hbm_settled", "gtt_before", "gtt_peak", "gtt_settled", "model_resident", "kv_logical", "kv_physical", "workspace"], "properties": {"hbm_before": {"$ref": "#/$defs/resource"}, "hbm_peak": {"$ref": "#/$defs/resource"}, "hbm_settled": {"$ref": "#/$defs/resource"}, "gtt_before": {"$ref": "#/$defs/resource"}, "gtt_peak": {"$ref": "#/$defs/resource"}, "gtt_settled": {"$ref": "#/$defs/resource"}, "model_resident": {"$ref": "#/$defs/resource"}, "kv_logical": {"$ref": "#/$defs/resource"}, "kv_physical": {"$ref": "#/$defs/resource"}, "workspace": {"$ref": "#/$defs/resource"}}},
    "decision": {"enum": ["PASS", "FAIL", "UNSUPPORTED", "MISSING"]},
    "decisions": {"type": "object", "additionalProperties": false, "required": ["correctness", "quality", "performance", "memory", "fallback", "cleanup"], "properties": {"correctness": {"$ref": "#/$defs/decision"}, "quality": {"$ref": "#/$defs/decision"}, "performance": {"$ref": "#/$defs/decision"}, "memory": {"$ref": "#/$defs/decision"}, "fallback": {"$ref": "#/$defs/decision"}, "cleanup": {"$ref": "#/$defs/decision"}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["configuration", "warmups", "measured", "rejected", "timing", "resources", "decisions"], "properties": {"configuration": {"$ref": "#/$defs/configuration"}, "warmups": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/sample"}}, "measured": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/sample"}}, "rejected": {"type": "array", "items": {"$ref": "#/$defs/sample"}}, "timing": {"oneOf": [{"$ref": "#/$defs/timing"}, {"type": "null"}]}, "resources": {"$ref": "#/$defs/resources"}, "decisions": {"$ref": "#/$defs/decisions"}}}
  }
}
