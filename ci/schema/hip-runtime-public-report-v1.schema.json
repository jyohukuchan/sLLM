{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/hip-runtime-public-report-v1.schema.json",
  "title": "sLLM H3 public HIP runtime compile-only report v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {"enum": ["gfx1030", "gfx1201"]},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_sha", "tree_oid", "reviewed_sha", "tested_sha", "workflow_sha"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha40"}, "tree_oid": {"$ref": "#/$defs/sha40"},
        "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"},
        "workflow_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "run_attempt"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["public_runtime_stub_linked", "compile_only", "execution_attempted", "gpu_execution", "model_used", "network_used", "fallback_allowed", "fallback_used", "cpu_fallback_used", "support_claim", "numerics_verified", "performance_verified"],
      "properties": {
        "public_runtime_stub_linked": {"const": false}, "compile_only": {"const": true},
        "execution_attempted": {"const": false}, "gpu_execution": {"const": false},
        "model_used": {"const": false}, "network_used": {"const": false},
        "fallback_allowed": {"const": false}, "fallback_used": {"const": false},
        "cpu_fallback_used": {"const": false}, "support_claim": {"const": false},
        "numerics_verified": {"const": false}, "performance_verified": {"const": false}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "execution_scope", "container_image_reference", "observed_image_config_digest", "pinned_container", "identity_verified", "network_isolated"],
      "properties": {
        "mode": {"type": "string"}, "execution_scope": {"type": "string"},
        "container_image_reference": {"type": "string", "minLength": 1},
        "observed_image_config_digest": {"type": "string", "minLength": 1},
        "pinned_container": {"type": "boolean"}, "identity_verified": {"type": "boolean"}, "network_isolated": {"type": "boolean"}
      }
    },
    "exact_environment": {
      "const": {
        "mode": "required-ci",
        "execution_scope": "official-container",
        "container_image_reference": "docker.io/rocm/dev-ubuntu-24.04@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7",
        "observed_image_config_digest": "sha256:4c91c0d850e38a40fd669dd043ab42e9bad9a2b8a38e3f873c5a4eaced9f28cf",
        "pinned_container": true,
        "identity_verified": true,
        "network_isolated": true
      }
    },
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "digest_record": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "sidecar_path", "sidecar_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_path": {"type": "string", "pattern": "^/[^\\u0000]+\\.sha256$"},
        "sidecar_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metadata_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "sidecar_sha256"],
      "properties": {"path": {"const": "hip-runtime-artifact.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["output_bytes", "output_limit_bytes", "max_rss_bytes", "max_rss_limit_bytes", "timed_out"],
      "properties": {
        "output_bytes": {"type": "integer", "minimum": 0}, "output_limit_bytes": {"type": "integer", "minimum": 1},
        "max_rss_bytes": {"type": "integer", "minimum": 0}, "max_rss_limit_bytes": {"type": "integer", "minimum": 1},
        "timed_out": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["step_id", "state"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}, "state": {"enum": ["PASS", "FAIL"]},
        "argv": {"type": "array", "items": {"type": "string", "minLength": 1}}, "exit_code": {"type": "integer"},
        "started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"},
        "duration_seconds": {"type": "number", "minimum": 0}, "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"}, "diagnostic": {"type": "string"}, "resource": {"$ref": "#/$defs/resource"}
      }
    }
  },
  "required": ["schema_version", "report_id", "row_id", "target", "state", "required", "evidence_mode", "run", "reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "candidate", "toolchain_id", "matrix_id", "matrix_manifest_sha256", "scope", "execution_environment", "compile_only_contract", "steps", "diagnostics", "metadata", "hashes", "started_at", "finished_at", "duration_seconds", "no_output_execution"],
  "properties": {
    "schema_version": {"const": "hip-runtime-public-report-v1"},
    "report_id": {"type": "string", "pattern": "^h3-public-runtime\\.gfx(?:1030|1201)\\.[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\.[1-9][0-9]*$"},
    "row_id": {"type": "string", "pattern": "^h3-public-gfx(?:1030|1201)$"}, "target": {"$ref": "#/$defs/target"},
    "state": {"enum": ["PASS", "FAIL"]}, "required": {"const": false}, "evidence_mode": {"const": "required-ci"},
    "run": {"$ref": "#/$defs/run"}, "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"},
    "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "candidate": {"$ref": "#/$defs/candidate"},
    "toolchain_id": {"const": "rocm-7.14.0"}, "matrix_id": {"const": "hip-runtime-compile-v1"}, "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {"$ref": "#/$defs/scope"}, "execution_environment": {"$ref": "#/$defs/environment"},
    "compile_only_contract": {"const": "compile-only; no GPU/support/model/network/fallback evidence"},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}, "diagnostics": {"type": "array", "items": {"type": "string"}},
    "metadata": {"oneOf": [{"$ref": "#/$defs/metadata_reference"}, {"type": "null"}]},
    "hashes": {
      "type": "object", "additionalProperties": false,
      "properties": {"probe_object": {"$ref": "#/$defs/digest_record"}, "public_runtime_object": {"$ref": "#/$defs/digest_record"}, "rmsnorm_kernel_object": {"$ref": "#/$defs/digest_record"}, "rmsnorm_api_object": {"$ref": "#/$defs/digest_record"}, "host_elf": {"$ref": "#/$defs/digest_record"}, "probe_fatbin": {"$ref": "#/$defs/digest_record"}, "device_object": {"$ref": "#/$defs/digest_record"}, "metadata": {"$ref": "#/$defs/digest_record"}}
    },
    "started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"}, "duration_seconds": {"type": "number", "minimum": 0}, "no_output_execution": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PASS"}}, "required": ["state"]},
      "then": {
        "properties": {
          "execution_environment": {"$ref": "#/$defs/exact_environment"},
          "metadata": {"$ref": "#/$defs/metadata_reference"},
          "steps": {"minItems": 5, "maxItems": 5},
          "hashes": {
            "required": ["metadata", "probe_object", "public_runtime_object", "rmsnorm_kernel_object", "rmsnorm_api_object", "host_elf", "probe_fatbin", "device_object"]
          }
        }
      }
    }
  ]
}
