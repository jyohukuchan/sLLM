{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/hygiene-allowlist-v1.schema.json",
  "title": "sLLM hygiene allowlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "hygiene-allowlist-v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "owner", "license", "deletion_condition", "approved_by", "approved_at", "max_bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "deletion_condition": {"type": "string", "minLength": 1},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "max_bytes": {"type": "integer", "minimum": 1},
          "max_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
