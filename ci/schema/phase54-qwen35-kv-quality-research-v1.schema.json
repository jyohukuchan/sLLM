      "required": ["encoding", "descriptor_id", "aggregate", "cases"],
      "properties": {
        "encoding": {"enum": ["kv-fp8-e5-block16", "kv-fp8-e4-block16", "kv-mxfp8-e5", "kv-mxfp8-e4"]},
        "descriptor_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "aggregate": {"$ref": "#/$defs/aggregate"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
      }
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_count", "metric_sample_counts", "perplexity_relative_delta", "kld_p99", "top1_agreement", "task_score_delta", "long_context_score_delta", "first_top1_divergence", "maximum_logit_delta", "finite", "hip_dispatches", "fallback_used", "all_dispatches_hip"],
      "properties": {
        "selected_count": {"type": "integer", "minimum": 1},
        "metric_sample_counts": {"$ref": "#/$defs/metric_sample_counts"},
        "perplexity_relative_delta": {"$ref": "#/$defs/finite_number"},
        "kld_p99": {"$ref": "#/$defs/finite_nonnegative"},
        "top1_agreement": {"$ref": "#/$defs/finite_unit"},
        "task_score_delta": {"$ref": "#/$defs/finite_unit"},
        "long_context_score_delta": {"$ref": "#/$defs/finite_unit"},
        "first_top1_divergence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/top1_divergence"}]},
        "maximum_logit_delta": {"$ref": "#/$defs/logit_delta_locator"},
        "finite": {"const": true},
        "hip_dispatches": {"type": "integer", "minimum": 1},
        "fallback_used": {"const": false},
        "all_dispatches_hip": {"const": true}
      }
    },
    "metric_sample_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["perplexity", "kld", "top1", "task", "long-context"],
      "properties": {
        "perplexity": {"type": "integer", "minimum": 1},
        "kld": {"type": "integer", "minimum": 1},
        "top1": {"type": "integer", "minimum": 1},
        "task": {"type": "integer", "minimum": 1},
        "long-context": {"type": "integer", "minimum": 1}
      }
    },
    "top1_divergence": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "row", "measured_row_index", "reference_top1", "observed_top1"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^b[0-9]{3}$"},
        "row": {"enum": ["prefill", "decode"]},
        "measured_row_index": {"type": "integer", "minimum": 0},
        "reference_top1": {"type": "integer", "minimum": 0},
        "observed_top1": {"type": "integer", "minimum": 0}
      }
    },
    "logit_delta_locator": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "row", "measured_row_index", "logit_index", "max_abs_logit_delta"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^b[0-9]{3}$"},
        "row": {"enum": ["prefill", "decode"]},
        "measured_row_index": {"type": "integer", "minimum": 0},
        "logit_index": {"type": "integer", "minimum": 0},
        "max_abs_logit_delta": {"$ref": "#/$defs/finite_nonnegative"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "length", "long", "prefill_nll", "prefill", "decode"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^b[0-9]{3}$"},
        "length": {"type": "integer", "minimum": 1},
        "long": {"type": "boolean"},
        "prefill_nll": {"$ref": "#/$defs/nll"},
        "prefill": {"$ref": "#/$defs/row"},
        "decode": {"$ref": "#/$defs/row"}
      }
    },
    "nll": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "observed", "delta"],
      "properties": {
        "reference": {"$ref": "#/$defs/finite_nonnegative"},
        "observed": {"$ref": "#/$defs/finite_nonnegative"},
        "delta": {"$ref": "#/$defs/finite_number"}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_top1", "observed_top1", "top1_match", "kld", "max_abs_logit_delta", "max_abs_logit_index", "reference_finite", "observed_finite"],
      "properties": {
        "reference_top1": {"type": "integer", "minimum": 0},
        "observed_top1": {"type": "integer", "minimum": 0},
        "top1_match": {"type": "boolean"},
        "kld": {"$ref": "#/$defs/finite_nonnegative"},
        "max_abs_logit_delta": {"$ref": "#/$defs/finite_nonnegative"},
        "max_abs_logit_index": {"type": "integer", "minimum": 0},
        "reference_finite": {"const": true},
        "observed_finite": {"const": true}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["retryable", "durable", "poisoned", "terminal_zero"],
      "properties": {"retryable": {"const": 0}, "durable": {"const": 0}, "poisoned": {"const": false}, "terminal_zero": {"const": true}}
    }
  }
}
