{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-h3-aggregate-v1.schema.json",
  "title": "sLLM dedicated RMSNorm H3 aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {"sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "required": ["schema_version", "aggregate_id", "suite_id", "tier", "state", "required", "evidence_mode", "run_id", "run_attempt", "reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "matrix_id", "matrix_manifest_sha256", "workflow_file_sha256", "expected_rows", "rows", "source_sets", "source_symbol_map", "toolchain", "container", "codegen", "logical_kernel", "device_symbol", "case_manifest", "scope", "counts", "errors", "timestamps"],
  "properties": {
    "schema_version": {"const": "rmsnorm-h3-aggregate-v1"}, "aggregate_id": {"type": "string", "pattern": "^rmsnorm-h3-aggregate-[A-Za-z0-9_.:-]+$"}, "suite_id": {"const": "h3-rmsnorm-compile-only"}, "tier": {"const": "tier_h3_rmsnorm"}, "state": {"enum": ["PASS", "FAIL"]}, "required": {"const": false}, "evidence_mode": {"enum": ["required-ci", "local-nonstrict"]}, "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1}, "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "matrix_id": {"const": "rmsnorm-h3-compile-v1"}, "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"}, "workflow_file_sha256": {"$ref": "#/$defs/sha256"}, "expected_rows": {"const": ["h3-rmsnorm-gfx1030", "h3-rmsnorm-gfx1201"]}, "rows": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["row_id", "target", "state", "report", "report_sha256", "report_sidecar_sha256", "metadata_sha256", "metadata_sidecar_sha256"], "properties": {"row_id": {"pattern": "^h3-rmsnorm-gfx(?:1030|1201)$", "type": "string"}, "target": {"enum": ["gfx1030", "gfx1201"]}, "state": {"const": "PASS"}, "report": {"const": "rmsnorm-h3-report.json"}, "report_sha256": {"$ref": "#/$defs/sha256"}, "report_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "metadata_sha256": {"$ref": "#/$defs/sha256"}, "metadata_sidecar_sha256": {"$ref": "#/$defs/sha256"}}}}, "source_sets": {"type": "object", "additionalProperties": false, "required": ["device", "host_abi", "binding_build", "ci_contract"], "properties": {"device": {"type": "object"}, "host_abi": {"type": "object"}, "binding_build": {"type": "object"}, "ci_contract": {"type": "object"}}}, "source_symbol_map": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}}, "toolchain": {"type": "object"}, "container": {"type": "object"}, "codegen": {"type": "object"}, "logical_kernel": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "case_manifest": {"type": "object", "additionalProperties": false, "required": ["id", "selected_count", "collected_count"], "properties": {"id": {"const": "rmsnorm-h3-compile-link-extract-inspect-v1"}, "selected_count": {"const": 2}, "collected_count": {"const": 2}}}, "scope": {"type": "object", "additionalProperties": false, "required": ["compile_only", "execution_attempted", "gpu_execution", "model_used", "network_used", "fallback_allowed", "fallback_used", "cpu_fallback_used", "fake_hip", "emulation"], "properties": {"compile_only": {"const": true}, "execution_attempted": {"const": false}, "gpu_execution": {"const": false}, "model_used": {"const": false}, "network_used": {"const": false}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}, "fake_hip": {"const": false}, "emulation": {"const": false}}}, "counts": {"type": "object", "additionalProperties": false, "required": ["expected_rows", "selected_rows", "collected_rows", "passed_rows", "failed_rows"], "properties": {"expected_rows": {"const": 2}, "selected_rows": {"const": 2}, "collected_rows": {"const": 2}, "passed_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "failed_rows": {"type": "integer", "minimum": 0, "maximum": 2}}}, "errors": {"type": "array", "items": {"type": "string"}}, "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at"], "properties": {"started_at": {"type": "string"}, "finished_at": {"type": "string"}}}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "PASS"}}}, "then": {"required": ["scope"], "properties": {"rows": {"minItems": 2, "maxItems": 2}, "errors": {"maxItems": 0}}}}, {"if": {"properties": {"state": {"const": "FAIL"}}}, "then": {"properties": {"errors": {"minItems": 1}}}}]
}
