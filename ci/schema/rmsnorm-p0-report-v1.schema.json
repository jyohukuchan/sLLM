{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-p0-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "row_id", "target", "state", "required", "run", "candidate", "tree_oid", "matrix", "review_policy", "case_set_sha256", "model_lock", "source_set_sha256", "artifact", "dtype", "scope", "device", "dispatch", "prerequisites", "measurements", "measurement_sha256", "runtime_result_sha256", "health_pre", "health_post", "process_pre", "process_post", "execution", "collection"],
  "properties": {
    "schema_version": {"const": "rmsnorm-p0-report-v1"},
    "report_id": {"type": "string", "minLength": 1},
    "row_id": {"enum": ["rmsnorm-p0-gfx1030", "rmsnorm-p0-gfx1201"]},
    "target": {"enum": ["gfx1030", "gfx1201"]},
    "state": {"enum": ["PASS", "FAIL"]},
    "required": {"const": true},
    "run": {"$ref": "#/$defs/run"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "tree_oid": {"$ref": "#/$defs/sha40"},
    "matrix": {"$ref": "#/$defs/identity"},
    "review_policy": {"$ref": "#/$defs/identity"},
    "case_set_sha256": {"$ref": "#/$defs/sha256"},
    "model_lock": {"$ref": "#/$defs/model_lock"},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "dtype": {"$ref": "#/$defs/dtype"},
    "scope": {"$ref": "#/$defs/scope"},
    "device": {"$ref": "#/$defs/device"},
    "dispatch": {"$ref": "#/$defs/dispatch_summary"},
    "prerequisites": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/prerequisite"}},
    "measurements": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/case"}},
    "measurement_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_result_sha256": {"$ref": "#/$defs/sha256"},
    "health_pre": {"$ref": "#/$defs/health"},
    "health_post": {"$ref": "#/$defs/health"},
    "process_pre": {"$ref": "#/$defs/process"},
    "process_post": {"$ref": "#/$defs/process"},
    "execution": {"$ref": "#/$defs/execution"},
    "collection": {"$ref": "#/$defs/collection"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "run_attempt"], "properties": {"run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "model_lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "fingerprint", "resolved_revision", "used"], "properties": {"path": {"const": "docs/models/locks/qwen3.5-4b-bf16.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "fingerprint": {"const": "sha256:32265444b7cdd2a00e4e4e3e6aa8375a05acf6cddfcb9ffc348f54f67a7cd935"}, "resolved_revision": {"const": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"}, "used": {"const": false}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_sha256", "binary_sha256", "binary_sidecar_sha256", "source_set_sha256", "binary_role", "producer_status"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "binary_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "source_set_sha256": {"$ref": "#/$defs/sha256"}, "binary_role": {"const": "dedicated-p0-public-rmsnorm-producer"}, "producer_status": {"const": "a5-enabled"}}},
    "dtype": {"type": "object", "additionalProperties": false, "required": ["activation", "weight", "output", "accumulation", "scale_mode", "epsilon"], "properties": {"activation": {"const": "BF16"}, "weight": {"const": "BF16"}, "output": {"const": "BF16"}, "accumulation": {"const": "F32"}, "scale_mode": {"const": "offset-one"}, "epsilon": {"const": "1e-6"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["selected_backend", "gpu_execution", "public_rmsnorm_path", "semantic_op_used", "model_used", "fallback_allowed", "fallback_used", "cpu_fallback_used", "optimized_claim", "other_engine_comparison", "performance_hard_gate"], "properties": {"selected_backend": {"const": "hip"}, "gpu_execution": {"type": "boolean"}, "public_rmsnorm_path": {"const": true}, "semantic_op_used": {"const": true}, "model_used": {"const": false}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}, "optimized_claim": {"const": false}, "other_engine_comparison": {"const": false}, "performance_hard_gate": {"const": false}}},
    "device": {"type": "object", "additionalProperties": false, "required": ["bdf", "uuid", "product", "target", "physical_hip_index", "logical_device_index"], "properties": {"bdf": {"type": "string", "minLength": 1}, "uuid": {"type": "string", "minLength": 1}, "product": {"type": "string", "minLength": 1}, "target": {"enum": ["gfx1030", "gfx1201"]}, "physical_hip_index": {"type": "integer", "minimum": 0}, "logical_device_index": {"const": 0}}},
    "dispatch_summary": {"type": "object", "additionalProperties": false, "required": ["backend", "kernel_id", "kernel_symbol", "device_symbol", "workgroup_size_x", "dispatch_count", "fallback_allowed", "fallback_used"], "properties": {"backend": {"const": "hip"}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "workgroup_size_x": {"const": 256}, "dispatch_count": {"type": "integer", "minimum": 0, "maximum": 130}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["kind", "row_id", "state", "candidate_sha256", "artifact_sha256", "report_sha256"], "properties": {"kind": {"enum": ["g0", "private_g1", "semantic_g1", "g2", "h3"]}, "row_id": {"type": "string", "minLength": 1}, "state": {"const": "bound-not-executed-by-p0"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "report_sha256": {"$ref": "#/$defs/sha256"}}},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["iteration", "dispatch_id", "dispatch_count", "kernel_id", "kernel_symbol", "device_symbol", "fallback_used"], "properties": {"iteration": {"type": "integer", "minimum": 0}, "dispatch_id": {"type": "integer", "minimum": 1}, "dispatch_count": {"const": 1}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "fallback_used": {"const": false}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["iteration", "dispatch_id", "dispatch_count", "kernel_id", "kernel_symbol", "device_symbol", "fallback_used", "kernel_latency_ns", "wall_latency_ns"], "properties": {"iteration": {"type": "integer", "minimum": 0}, "dispatch_id": {"type": "integer", "minimum": 1}, "dispatch_count": {"const": 1}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "fallback_used": {"const": false}, "kernel_latency_ns": {"type": "integer", "minimum": 1}, "wall_latency_ns": {"type": "integer", "minimum": 1}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["kernel_median_ns", "kernel_mad_ns", "wall_median_ns", "wall_mad_ns", "sample_set_sha256"], "properties": {"kernel_median_ns": {"type": "integer", "minimum": 1}, "kernel_mad_ns": {"type": "integer", "minimum": 0}, "wall_median_ns": {"type": "integer", "minimum": 1}, "wall_mad_ns": {"type": "integer", "minimum": 0}, "sample_set_sha256": {"$ref": "#/$defs/sha256"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["order", "id", "rows", "n", "input_seed", "classification", "state", "warmup_dispatches", "samples", "summary"], "properties": {"order": {"type": "integer", "minimum": 0, "maximum": 4}, "id": {"type": "string", "minLength": 1}, "rows": {"type": "integer", "minimum": 1}, "n": {"type": "integer", "minimum": 1, "maximum": 4096}, "input_seed": {"type": "integer", "minimum": 0}, "classification": {"type": "string", "minLength": 1}, "state": {"const": "PASS"}, "warmup_dispatches": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/dispatch"}}, "samples": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/sample"}}, "summary": {"$ref": "#/$defs/summary"}}},
    "health": {"type": "object", "additionalProperties": false, "required": ["available", "reliable", "state", "target", "ras_uncorrectable_count"], "properties": {"available": {"type": "boolean"}, "reliable": {"type": "boolean"}, "state": {"enum": ["OK", "UNAVAILABLE", "DEGRADED"]}, "target": {"enum": ["gfx1030", "gfx1201"]}, "ras_uncorrectable_count": {"type": "integer", "minimum": 0}}},
    "process": {"type": "object", "additionalProperties": false, "required": ["state", "residual_runner_children", "gpu_processes"], "properties": {"state": {"enum": ["CLEAN", "RESIDUAL"]}, "residual_runner_children": {"type": "array", "maxItems": 0, "items": false}, "gpu_processes": {"type": "array", "maxItems": 0, "items": false}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at", "duration_ns", "exit_code", "timed_out", "crashed", "stdout_sha256", "stderr_sha256", "failure_reason"], "properties": {"started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "duration_ns": {"type": "integer", "minimum": 0}, "exit_code": {"type": "integer"}, "timed_out": {"type": "boolean"}, "crashed": {"type": "boolean"}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "failure_reason": {"type": "string"}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["expected_cases", "collected_cases", "passed_cases", "failed_cases", "warmup_dispatches", "measurement_dispatches"], "properties": {"expected_cases": {"const": 5}, "collected_cases": {"type": "integer", "minimum": 0, "maximum": 5}, "passed_cases": {"type": "integer", "minimum": 0, "maximum": 5}, "failed_cases": {"type": "integer", "minimum": 0, "maximum": 5}, "warmup_dispatches": {"type": "integer", "minimum": 0, "maximum": 25}, "measurement_dispatches": {"type": "integer", "minimum": 0, "maximum": 105}}}
  }
}
