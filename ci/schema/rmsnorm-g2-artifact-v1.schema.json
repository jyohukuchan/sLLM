{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-g2-artifact-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "row_id", "target", "artifact_kind", "candidate", "binary", "scope", "backend", "dispatch_contract", "prerequisites"],
  "properties": {
    "schema_version": {"const": "rmsnorm-g2-artifact-v1"},
    "artifact_id": {"type": "string", "pattern": "^rmsnorm-g2-(?:gfx1030|gfx1201)-[0-9a-f]{64}$"},
    "row_id": {"enum": ["rmsnorm-g2-gfx1030", "rmsnorm-g2-gfx1201"]},
    "target": {"enum": ["gfx1030", "gfx1201"]}, "artifact_kind": {"const": "rmsnorm-g2-dedicated-public-rmsnorm"},
    "candidate": {"$ref": "#/$defs/candidate"}, "binary": {"$ref": "#/$defs/binary"},
    "scope": {"$ref": "#/$defs/scope"}, "backend": {"const": "hip"}, "dispatch_contract": {"$ref": "#/$defs/dispatch"},
    "prerequisites": {"$ref": "#/$defs/prerequisites"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_set": {"type": "object", "additionalProperties": false, "required": ["canonical_order", "files", "source_set_sha256"], "properties": {"canonical_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}, "source_set_sha256": {"$ref": "#/$defs/sha256"}}},
    "build_identity": {"type": "object", "additionalProperties": false, "required": ["binary_name", "identity_schema", "role", "source_order_sha256", "source_path", "source_set_manifest_sha256", "source_set_sha256", "source_sha256", "identity_sha256"], "properties": {"binary_name": {"const": "sllm-rmsnorm-g2-evidence"}, "identity_schema": {"const": "rmsnorm-g2-build-identity-v1"}, "role": {"const": "dedicated-g2-runtime"}, "source_order_sha256": {"$ref": "#/$defs/sha256"}, "source_path": {"const": "crates/sllm-hip/src/bin/sllm-rmsnorm-g2-evidence.rs"}, "source_set_manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_set_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sidecar_path", "size_bytes", "sha256", "sidecar_sha256", "source_path", "source_sha256", "build_source_set", "build_identity", "build_command", "build_profile", "build_environment", "builder_output_path", "g2_binary_name", "g1_substitution_rejected", "h3_substitution_rejected"], "properties": {"role": {"const": "dedicated-g2-runtime"}, "path": {"const": "sllm-rmsnorm-g2-evidence"}, "sidecar_path": {"const": "sllm-rmsnorm-g2-evidence.sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"}, "source_path": {"const": "crates/sllm-hip/src/bin/sllm-rmsnorm-g2-evidence.rs"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "build_source_set": {"$ref": "#/$defs/source_set"}, "build_identity": {"$ref": "#/$defs/build_identity"}, "build_command": {"const": ["cargo", "+1.97.1", "build", "--locked", "--offline", "--release", "--bin", "sllm-rmsnorm-g2-evidence"]}, "build_profile": {"const": "release"}, "build_environment": {"type":"object","additionalProperties":false,"required":["ROCM_PATH","HIP_PATH","SLLM_HIP_COMPILER","CMAKE_HIP_ARCHITECTURES","SLLM_HIP_CODEGEN_FEATURES","SLLM_ENABLE_HIP_RUNTIME","SLLM_ENABLE_PUBLIC_HIP_RUNTIME","SLLM_ENABLE_HIP_COMPILE_PROBE"],"properties":{"ROCM_PATH":{"const":"/opt/rocm"},"HIP_PATH":{"const":"/opt/rocm"},"SLLM_HIP_COMPILER":{"const":"/opt/rocm/bin/amdclang++"},"CMAKE_HIP_ARCHITECTURES":{"enum":["gfx1030","gfx1201"]},"SLLM_HIP_CODEGEN_FEATURES":{"const":"co_v6,wave32,xnack=unsupported,sramecc=unsupported,generic_processor_version=0"},"SLLM_ENABLE_HIP_RUNTIME":{"const":"1"},"SLLM_ENABLE_PUBLIC_HIP_RUNTIME":{"const":"1"},"SLLM_ENABLE_HIP_COMPILE_PROBE":{"const":"0"}}}, "builder_output_path": {"const": "target/release/sllm-rmsnorm-g2-evidence"}, "g2_binary_name": {"const": "sllm-rmsnorm-g2-evidence"}, "g1_substitution_rejected": {"const": true}, "h3_substitution_rejected": {"const": true}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["model_used", "full_model_used", "tokenizer_used", "generation_used", "hip_only", "fallback_allowed", "fallback_used", "cpu_fallback_used"], "properties": {"model_used": {"const": true}, "full_model_used": {"const": false}, "tokenizer_used": {"const": false}, "generation_used": {"const": false}, "hip_only": {"const": true}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}}},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["backend", "kernel_id", "kernel_symbol", "device_symbol", "dispatch_count", "workgroup_size_x", "fallback_allowed", "fallback_used"], "properties": {"backend": {"const": "hip"}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "dispatch_count": {"const": 1}, "workgroup_size_x": {"const": 256}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["kind", "row_id", "state", "candidate_sha256", "artifact_sha256", "report_sha256"], "properties": {"kind": {"enum": ["g0", "private_g1", "semantic_g1", "h3"]}, "row_id": {"type": "string", "minLength": 1}, "state": {"const": "bound-not-executed-by-g2"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "report_sha256": {"$ref": "#/$defs/sha256"}}},
    "prerequisites": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/prerequisite"}}
  }
}
