{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-p0-aggregate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "aggregate_id", "state", "required", "candidate", "tree_oid", "run", "matrix", "review_policy", "case_set_sha256", "model_lock", "source_set_sha256", "rows", "counts", "review_disposition", "claims"],
  "properties": {
    "schema_version": {"const": "rmsnorm-p0-aggregate-v1"},
    "aggregate_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["PASS", "FAIL"]},
    "required": {"const": true},
    "candidate": {"$ref": "#/$defs/candidate"},
    "tree_oid": {"$ref": "#/$defs/sha40"},
    "run": {"$ref": "#/$defs/run"},
    "matrix": {"$ref": "#/$defs/identity"},
    "review_policy": {"$ref": "#/$defs/identity"},
    "case_set_sha256": {"$ref": "#/$defs/sha256"},
    "model_lock": {"$ref": "#/$defs/model_lock"},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "rows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/row"}},
    "counts": {"$ref": "#/$defs/counts"},
    "review_disposition": {"$ref": "#/$defs/disposition"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "run_attempt"], "properties": {"run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "model_lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "fingerprint", "resolved_revision"], "properties": {"path": {"const": "docs/models/locks/qwen3.5-4b-bf16.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "fingerprint": {"const": "sha256:32265444b7cdd2a00e4e4e3e6aa8375a05acf6cddfcb9ffc348f54f67a7cd935"}, "resolved_revision": {"const": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["order", "row_id", "target", "state", "report_sha256", "artifact_sha256", "candidate_sha256", "tuple_sha256", "measurement_sha256", "collected_cases", "dispatch_count", "fallback_used", "health_ok", "process_clean"], "properties": {"order": {"type": "integer", "minimum": 0, "maximum": 1}, "row_id": {"enum": ["rmsnorm-p0-gfx1030", "rmsnorm-p0-gfx1201"]}, "target": {"enum": ["gfx1030", "gfx1201"]}, "state": {"enum": ["PASS", "FAIL"]}, "report_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "tuple_sha256": {"$ref": "#/$defs/sha256"}, "measurement_sha256": {"$ref": "#/$defs/sha256"}, "collected_cases": {"type": "integer", "minimum": 0, "maximum": 5}, "dispatch_count": {"type": "integer", "minimum": 0, "maximum": 130}, "fallback_used": {"const": false}, "health_ok": {"type": "boolean"}, "process_clean": {"type": "boolean"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["expected_rows", "selected_rows", "collected_rows", "passed_rows", "failed_rows", "expected_cases", "collected_cases"], "properties": {"expected_rows": {"const": 2}, "selected_rows": {"const": 2}, "collected_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "passed_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "failed_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "expected_cases": {"const": 10}, "collected_cases": {"type": "integer", "minimum": 0, "maximum": 10}}},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "disposition_id", "performance_sanity_disposition", "reviewer", "reviewed_at"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "disposition_id": {"type": "string", "minLength": 1}, "performance_sanity_disposition": {"const": "review_required"}, "reviewer": {"type": "string", "minLength": 3}, "reviewed_at": {"type": "string", "format": "date-time"}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["optimized", "faster_than_other_engine", "performance_hard_gate_established"], "properties": {"optimized": {"const": false}, "faster_than_other_engine": {"const": false}, "performance_hard_gate_established": {"const": false}}}
  }
}
