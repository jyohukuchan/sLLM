{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.local/schema/phase24-terminal-row-summary-v1.schema.json",
  "title": "sLLM Phase 24 terminal-row adoption summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "decision",
    "recorded_at",
    "identity",
    "frozen_contract",
    "measurements",
    "correctness_and_audit",
    "mechanism_and_memory",
    "disposition"
  ],
  "properties": {
    "schema_version": {"const": "phase24-terminal-row-summary-v1"},
    "state": {"const": "COMPLETE"},
    "decision": {"const": "ADOPTED"},
    "recorded_at": {"type": "string", "format": "date"},
    "identity": {"$ref": "#/$defs/nonempty_object"},
    "frozen_contract": {"$ref": "#/$defs/nonempty_object"},
    "measurements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "correctness_and_audit": {"$ref": "#/$defs/nonempty_object"},
    "mechanism_and_memory": {"$ref": "#/$defs/nonempty_object"},
    "disposition": {"$ref": "#/$defs/nonempty_object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty_object": {"type": "object", "minProperties": 1},
    "sha256_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "case",
        "input_tokens",
        "output_tokens",
        "baseline_evidence_sha256",
        "candidate_evidence_sha256",
        "baseline_e2e_ns",
        "candidate_e2e_ns",
        "e2e_improvement",
        "baseline_primary_span",
        "candidate_primary_span",
        "no_regression_pass",
        "five_percent_pass"
      ],
      "properties": {
        "target": {"enum": ["gfx1030", "gfx1201"]},
        "case": {"enum": ["P0", "P1", "P2", "P3", "D0"]},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "baseline_evidence_sha256": {"$ref": "#/$defs/sha256_array"},
        "candidate_evidence_sha256": {"$ref": "#/$defs/sha256_array"},
        "baseline_e2e_ns": {"type": "number", "exclusiveMinimum": 0},
        "candidate_e2e_ns": {"type": "number", "exclusiveMinimum": 0},
        "e2e_improvement": {"type": "number"},
        "baseline_primary_span": {"type": "number", "exclusiveMinimum": 0},
        "candidate_primary_span": {"type": "number", "exclusiveMinimum": 0},
        "no_regression_pass": {"const": true},
        "five_percent_pass": {"type": "boolean"}
      }
    }
  }
}
