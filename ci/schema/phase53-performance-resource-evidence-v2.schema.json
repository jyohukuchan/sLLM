{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.dev/schema/phase53-performance-resource-evidence-v2.schema.json",
  "title": "sLLM Phase 53 revised-recipe performance and resource evidence",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "state", "producer", "target", "encoding", "descriptor_id", "scale_recipe", "policy_sha256", "binary_sha256", "hbm_observation_sha256", "model_lock_fingerprint", "selected_count", "rows", "memory", "decisions", "fallback_used", "cleanup"],
  "properties": {
    "$schema": {"const": "https://sllm.dev/schema/phase53-performance-resource-evidence-v2.schema.json"},
    "schema_version": {"const": "sllm-phase53-performance-resource-evidence-v2"},
    "state": {"enum": ["PASS", "FAIL"]},
    "producer": {"const": "ci/tools/build_phase53_performance_resource.py"},
    "target": {"enum": ["gfx942:sramecc+:xnack-", "gfx1201", "gfx1030"]},
    "encoding": {"enum": ["kv-fp8-e4-block16", "kv-fp8-e5-block16"]},
    "descriptor_id": {"enum": ["kv-fp8-e4-block16-v2", "kv-fp8-e5-block16-v2"]},
    "scale_recipe": {"const": "standard-mx-floor-power-v1"},
    "policy_sha256": {"$ref": "#/$defs/digest"}, "binary_sha256": {"$ref": "#/$defs/digest"}, "hbm_observation_sha256": {"$ref": "#/$defs/digest"},
    "model_lock_fingerprint": {"const": "sha256:f143d7b504170d071c77818105f7a07dc0297c6bea0c61a5404b071fed0c1fae"},
    "selected_count": {"const": 7},
    "rows": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/row"}},
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["fp16_bytes_per_token_head_plane", "candidate_bytes_per_token_head_plane", "logical_reduction_fraction", "candidate_physical_kv_bytes_max", "physical_measured"],
      "properties": {
        "fp16_bytes_per_token_head_plane": {"const": 512}, "candidate_bytes_per_token_head_plane": {"const": 272},
        "logical_reduction_fraction": {"const": 0.46875}, "candidate_physical_kv_bytes_max": {"type": "integer", "minimum": 1}, "physical_measured": {"const": true}
      }
    },
    "decisions": {
      "type": "object", "additionalProperties": false, "required": ["performance", "resource", "memory"],
      "properties": {"performance": {"enum": ["pass", "fail"]}, "resource": {"enum": ["pass", "fail"]}, "memory": {"enum": ["pass", "fail"]}}
    },
    "fallback_used": {"const": false},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["retryable", "durable", "settled"], "properties": {"retryable": {"const": 0}, "durable": {"const": 0}, "settled": {"const": true}}}
  },
  "allOf": [
    {"if": {"properties": {"target": {"const": "gfx1030"}}}, "then": {"properties": {"encoding": {"const": "kv-fp8-e5-block16"}, "descriptor_id": {"const": "kv-fp8-e5-block16-v2"}}}},
    {"if": {"properties": {"target": {"enum": ["gfx942:sramecc+:xnack-", "gfx1201"]}}}, "then": {"properties": {"encoding": {"const": "kv-fp8-e4-block16"}, "descriptor_id": {"const": "kv-fp8-e4-block16-v2"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol": {"type": "object", "additionalProperties": false, "required": ["warmups", "measured", "context_length", "ignore_eos"], "properties": {"warmups": {"enum": [1, 3]}, "measured": {"enum": [3, 10]}, "context_length": {"type": "integer", "minimum": 1}, "ignore_eos": {"type": "boolean"}}},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_report_sha256", "row_id", "median_e2e_ns", "tokens_per_second", "logical_kv_bytes", "physical_kv_bytes", "hbm_peak_delta_bytes", "generated", "hip_only", "fallback_used", "cleanup_empty", "hbm_gtt_settled"],
      "properties": {
        "direct_report_sha256": {"$ref": "#/$defs/digest"}, "row_id": {"type": "string", "minLength": 1},
        "median_e2e_ns": {"type": "number", "exclusiveMinimum": 0}, "tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
        "logical_kv_bytes": {"type": "integer", "minimum": 1}, "physical_kv_bytes": {"type": "integer", "minimum": 1}, "hbm_peak_delta_bytes": {"type": "integer", "minimum": 0},
        "generated": {"const": true}, "hip_only": {"const": true}, "fallback_used": {"const": false}, "cleanup_empty": {"const": true}, "hbm_gtt_settled": {"const": true}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["row", "case_id", "class", "input_token_count", "requested_output_tokens", "protocol", "execution_order", "fp16", "candidate", "candidate_to_fp16_throughput_ratio"],
      "properties": {
        "row": {"type": "integer", "minimum": 1, "maximum": 7}, "case_id": {"enum": ["short-odd", "32-32", "prefill-long", "decode-long", "long-10001", "long-100000", "decode-20000"]},
        "class": {"enum": ["normal", "long-running"]}, "input_token_count": {"type": "integer", "minimum": 1}, "requested_output_tokens": {"type": "integer", "minimum": 1},
        "protocol": {"$ref": "#/$defs/protocol"}, "execution_order": {"const": ["fp16", "block16"]},
        "fp16": {"$ref": "#/$defs/run"}, "candidate": {"$ref": "#/$defs/run"}, "candidate_to_fp16_throughput_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
