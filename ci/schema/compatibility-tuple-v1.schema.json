{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ullm-project.local/ci/schema/compatibility-tuple-v1.schema.json",
  "title": "uLLM compatibility tuple v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tuple_id", "status", "os", "kernel", "driver", "rocm", "compiler", "gpu", "codegen", "capabilities", "test", "identity"],
  "properties": {
    "schema_version": {"const": "compatibility-tuple-v1"},
    "tuple_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "status": {"enum": ["supported", "experimental", "planned", "unsupported"]},
    "os": {"type": "object", "additionalProperties": false, "required": ["name", "version", "arch"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "arch": {"type": "string"}}},
    "kernel": {"type": "object", "additionalProperties": false, "required": ["release"], "properties": {"release": {"type": "string"}}},
    "driver": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "rocm": {"type": "object", "additionalProperties": false, "required": ["release", "runtime", "library_path"], "properties": {"release": {"type": "string"}, "runtime": {"type": "string"}, "library_path": {"type": "string"}}},
    "compiler": {"type": "object", "additionalProperties": false, "required": ["name", "version", "cxx_standard"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "cxx_standard": {"const": "c++17"}}},
    "gpu": {"type": "object", "additionalProperties": false, "required": ["product", "uuid", "bdf", "exact_target", "wave_size"], "properties": {"product": {"type": "string"}, "uuid": {"type": "string"}, "bdf": {"type": "string"}, "exact_target": {"type": "string", "pattern": "^gfx[0-9]+$"}, "wave_size": {"enum": [32, 64]}}},
    "codegen": {"type": "object", "additionalProperties": false, "required": ["target", "code_object", "xnack", "sramecc"], "properties": {"target": {"type": "string"}, "code_object": {"type": "string"}, "xnack": {"enum": ["unsupported", "any", "off", "on"]}, "sramecc": {"enum": ["unsupported", "any", "off", "on"]}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["profile", "fp8", "matrix_engine"], "properties": {"profile": {"type": "string"}, "fp8": {"type": "boolean"}, "matrix_engine": {"type": "boolean"}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["tiers", "seed", "timeout_seconds"], "properties": {"tiers": {"type": "array", "minItems": 1, "items": {"enum": ["tier_h0", "tier_h1", "tier_h2", "tier_h3", "tier_g0", "tier_g1", "tier_g2", "tier_g3", "tier_g4", "tier_p0", "tier_p1"]}}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "timeout_seconds": {"type": "integer", "minimum": 1}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256"], "properties": {"manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source": {"type": "string"}}}
  }
}
