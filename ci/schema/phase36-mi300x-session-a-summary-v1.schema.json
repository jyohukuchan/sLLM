{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/phase36-mi300x-session-a-summary-v1.schema.json",
  "title": "Phase 36 MI300X Session A summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "started_at", "target", "device_index", "dry_run", "expected_cases", "selected_cases", "families", "raw_outputs", "failure_count"],
  "properties": {
    "schema_version": {"const": "phase36-mi300x-session-a-summary-v1"},
    "state": {"enum": ["PASS", "FAIL", "DRY_RUN"]},
    "started_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "target": {"const": "gfx942"},
    "device_index": {"type": "integer", "minimum": 0, "maximum": 255},
    "dry_run": {"type": "boolean"},
    "expected_cases": {"const": 99},
    "selected_cases": {"type": "integer", "minimum": 0, "maximum": 99},
    "raw_outputs": {"const": "raw/"},
    "failure_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "families": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"},
        {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"},
        {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"}, {"$ref": "#/$defs/family"}
      ],
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "command": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "binary", "expected_cases", "command", "state", "selected_cases", "dispatch_count", "fallback_used", "cleanup_retryable", "cleanup_durable"],
      "properties": {
        "family": {"enum": ["fp8-matmul", "bf16-matmul", "elementwise", "attention-preprocess", "kv-state", "full-attention", "output-gate", "rmsnorm", "gdn"]},
        "binary": {"type": "string", "pattern": "^sllm-[a-z0-9-]+$"},
        "expected_cases": {"type": "integer", "minimum": 1, "maximum": 21},
        "command": {"$ref": "#/$defs/command"},
        "state": {"enum": ["PASS", "FAIL", "DRY_RUN"]},
        "selected_cases": {"type": "integer", "minimum": 0, "maximum": 21},
        "dispatch_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "fallback_used": {"const": false},
        "cleanup_retryable": {"const": 0},
        "cleanup_durable": {"const": 0},
        "cli": {"type": "string", "maxLength": 64},
        "error": {"type": "string", "minLength": 1, "maxLength": 1024},
        "cases": {"type": "array", "maxItems": 7, "items": {"type": "object", "maxProperties": 16}}
      }
    }
  }
}
