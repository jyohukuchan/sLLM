{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-g2-aggregate-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "aggregate_id", "state", "required", "candidate", "tree_oid", "matrix", "model_lock", "tolerance", "rows", "counts", "prerequisites", "raw_data_policy"],
  "properties": {
    "schema_version": {"const": "rmsnorm-g2-aggregate-v1"}, "aggregate_id": {"type": "string", "minLength": 1}, "state": {"enum": ["PASS", "FAIL"]}, "required": {"const": true},
    "candidate": {"$ref": "#/$defs/candidate"}, "tree_oid": {"$ref": "#/$defs/sha40"}, "matrix": {"$ref": "#/$defs/identity"}, "model_lock": {"$ref": "#/$defs/model_lock"}, "tolerance": {"$ref": "#/$defs/tolerance"},
    "rows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/row"}}, "counts": {"$ref": "#/$defs/counts"}, "prerequisites": {"$ref": "#/$defs/prerequisites"}, "raw_data_policy": {"$ref": "#/$defs/raw_policy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "model_lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "fingerprint", "resolved_revision"], "properties": {"path": {"const": "docs/models/locks/qwen3.5-4b-bf16.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "fingerprint": {"const": "sha256:f143d7b504170d071c77818105f7a07dc0297c6bea0c61a5404b071fed0c1fae"}, "resolved_revision": {"const": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"}}},
    "tolerance": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "tolerance_id", "atol", "rtol"], "properties": {"path": {"const": "ci/matrix/rmsnorm-g2-tolerance-v1.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "tolerance_id": {"const": "rmsnorm-bf16-f32-output-v1"}, "atol": {"const": 0.0078125}, "rtol": {"const": 0.015625}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["order", "row_id", "target", "state", "report_sha256", "artifact_sha256", "candidate_sha256", "tuple_sha256", "collected_cases", "dispatch_count", "fallback_used", "health_ok", "process_clean"], "properties": {"order": {"type": "integer", "minimum": 0, "maximum": 1}, "row_id": {"enum": ["rmsnorm-g2-gfx1030", "rmsnorm-g2-gfx1201"]}, "target": {"enum": ["gfx1030", "gfx1201"]}, "state": {"enum": ["PASS", "FAIL"]}, "report_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "tuple_sha256": {"$ref": "#/$defs/sha256"}, "collected_cases": {"type": "integer", "minimum": 0, "maximum": 6}, "dispatch_count": {"type": "integer", "minimum": 0}, "fallback_used": {"const": false}, "health_ok": {"type": "boolean"}, "process_clean": {"type": "boolean"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["expected_rows", "selected_rows", "collected_rows", "passed_rows", "failed_rows", "expected_cases", "collected_cases"], "properties": {"expected_rows": {"const": 2}, "selected_rows": {"const": 2}, "collected_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "passed_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "failed_rows": {"type": "integer", "minimum": 0, "maximum": 2}, "expected_cases": {"const": 12}, "collected_cases": {"type": "integer", "minimum": 0, "maximum": 12}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["kind", "row_id", "target", "state", "candidate_sha256", "artifact_sha256", "report_sha256"], "properties": {"kind": {"enum": ["g0", "private_g1", "semantic_g1", "h3"]}, "row_id": {"type": "string", "minLength": 1}, "target": {"enum": ["gfx1030", "gfx1201"]}, "state": {"const": "bound-not-executed-by-g2-aggregate"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "report_sha256": {"$ref": "#/$defs/sha256"}}},
    "prerequisites": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/prerequisite"}},
    "raw_policy": {"type": "object", "additionalProperties": false, "required": ["raw_model_git", "raw_slice_git", "raw_model_artifact", "raw_slice_artifact", "report_contains_paths", "report_contains_bytes"], "properties": {"raw_model_git": {"const": false}, "raw_slice_git": {"const": false}, "raw_model_artifact": {"const": false}, "raw_slice_artifact": {"const": false}, "report_contains_paths": {"const": false}, "report_contains_bytes": {"const": false}}}
  }
}
