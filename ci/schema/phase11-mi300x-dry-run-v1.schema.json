{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.invalid/schema/phase11-mi300x-dry-run-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "execution_attempted", "candidate_id", "target", "profiles", "totals"],
  "properties": {
    "schema_version": {"const": "phase11-mi300x-dry-run-v1"},
    "state": {"const": "PASS"},
    "execution_attempted": {"const": false},
    "candidate_id": {"const": "phase11-gfx942-single-gpu-v1"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_arch", "wave_size", "gpu_count"],
      "properties": {
        "exact_arch": {"const": "gfx942"},
        "wave_size": {"const": 64},
        "gpu_count": {"const": 1}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "estimated_minutes", "requires_model", "steps", "boundary_values"],
        "properties": {
          "name": {"enum": ["preflight", "operator", "slice", "full-model", "service", "performance"]},
          "estimated_minutes": {"type": "integer", "minimum": 1},
          "requires_model": {"type": "boolean"},
          "steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "boundary_values": {"type": "array", "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_profiles", "estimated_minutes"],
      "properties": {
        "selected_profiles": {"type": "integer", "minimum": 1, "maximum": 6},
        "estimated_minutes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
