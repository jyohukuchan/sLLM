{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-h3-artifact-v1.schema.json",
  "title": "sLLM dedicated RMSNorm H3 artifact evidence v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_set": {"type": "object", "additionalProperties": false, "required": ["canonical_order", "files", "source_set_sha256"], "properties": {"canonical_order": {"type": "array", "items": {"type": "string"}}, "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}, "source_set_sha256": {"$ref": "#/$defs/sha256"}}},
    "symbol": {"type": "object", "additionalProperties": false, "required": ["path", "symbol", "role"], "properties": {"path": {"type": "string"}, "symbol": {"type": "string"}, "role": {"type": "string"}}},
    "codegen": {"type": "object", "additionalProperties": false, "required": ["target", "target_kind", "target_count", "code_object_version", "wavefront_size", "features", "e_flags"], "properties": {"target": {"enum": ["gfx1030", "gfx1201"]}, "target_kind": {"const": "exact"}, "target_count": {"const": 1}, "code_object_version": {"const": "V6"}, "wavefront_size": {"const": 32}, "features": {"type": "object", "additionalProperties": false, "required": ["xnack", "sramecc", "generic_processor_version"], "properties": {"xnack": {"const": "unsupported"}, "sramecc": {"const": "unsupported"}, "generic_processor_version": {"const": 0}}}, "e_flags": {"enum": ["0x00000036", "0x0000004e"]}}},
    "digest_file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "sidecar_sha256", "size_bytes"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "inspection_symbol": {"type": "object", "additionalProperties": false, "required": ["name", "defined"], "properties": {"name": {"type": "string"}, "defined": {"const": true}}},
    "host": {"type": "object", "additionalProperties": false, "required": ["file", "format", "machine", "sections", "bundles", "public_symbols", "stub_symbols"], "properties": {"file": {"$ref": "#/$defs/digest_file"}, "format": {"const": "ELF64"}, "machine": {"const": "X86_64"}, "sections": {"type": "object", "additionalProperties": false, "required": [".text", ".hip_fatbin"], "properties": {".text": {"type": "integer", "minimum": 1}, ".hip_fatbin": {"type": "integer", "minimum": 1}}}, "bundles": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}, "public_symbols": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/inspection_symbol"}}, "stub_symbols": {"const": []}}},
    "device": {"type": "object", "additionalProperties": false, "required": ["file", "format", "machine", "target", "ei_abiversion", "e_flags", "code_object_version", "wavefront_size", "features", "sections", "symbols", "source_attribution"], "properties": {"file": {"$ref": "#/$defs/digest_file"}, "format": {"const": "ELF64"}, "machine": {"const": "AMDGPU"}, "target": {"enum": ["gfx1030", "gfx1201"]}, "ei_abiversion": {"const": 4}, "e_flags": {"enum": ["0x00000036", "0x0000004e"]}, "code_object_version": {"const": "V6"}, "wavefront_size": {"const": 32}, "features": {"type": "object", "additionalProperties": false, "required": ["xnack", "sramecc", "generic_processor_version"], "properties": {"xnack": {"const": "unsupported"}, "sramecc": {"const": "unsupported"}, "generic_processor_version": {"const": 0}}}, "sections": {"type": "object", "additionalProperties": false, "required": [".text", ".kd"], "properties": {".text": {"type": "integer", "minimum": 1}, ".kd": {"type": "integer", "minimum": 1}}}, "symbols": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/inspection_symbol"}}, "source_attribution": {"const": "rmsnorm_kernel.hip.cpp"}}}
  },
  "required": ["schema_version", "artifact_id", "suite_id", "tier", "state", "required", "row_id", "target", "reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "matrix_id", "matrix_manifest_sha256", "workflow_file_sha256", "schema_digests", "source_sets", "source_symbol_map", "toolchain", "container", "codegen", "logical_kernel", "device_symbol", "host_elf", "device_code_object", "case_manifest", "scope", "process", "timestamps"],
  "properties": {
    "schema_version": {"const": "rmsnorm-h3-artifact-v1"}, "artifact_id": {"type": "string", "pattern": "^rmsnorm-h3-artifact-[a-z0-9]+$"}, "suite_id": {"const": "h3-rmsnorm-compile-only"}, "tier": {"const": "tier_h3_rmsnorm"}, "state": {"const": "PASS"}, "required": {"const": false}, "row_id": {"pattern": "^h3-rmsnorm-gfx(?:1030|1201)$", "type": "string"}, "target": {"enum": ["gfx1030", "gfx1201"]}, "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"type": "boolean"}, "matrix_id": {"const": "rmsnorm-h3-compile-v1"}, "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"}, "workflow_file_sha256": {"$ref": "#/$defs/sha256"},
    "schema_digests": {"type": "object", "additionalProperties": false, "required": ["compile", "artifact", "report", "aggregate"], "properties": {"compile": {"$ref": "#/$defs/sha256"}, "artifact": {"$ref": "#/$defs/sha256"}, "report": {"$ref": "#/$defs/sha256"}, "aggregate": {"$ref": "#/$defs/sha256"}}},
    "source_sets": {"type": "object", "additionalProperties": false, "required": ["device", "host_abi", "binding_build", "ci_contract"], "properties": {"device": {"$ref": "#/$defs/source_set"}, "host_abi": {"$ref": "#/$defs/source_set"}, "binding_build": {"$ref": "#/$defs/source_set"}, "ci_contract": {"$ref": "#/$defs/source_set"}}}, "source_symbol_map": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/symbol"}}, "toolchain": {"type": "object", "additionalProperties": false, "required": ["id", "rocm_version", "llvm_major", "compiler", "compiler_version", "paths"], "properties": {"id": {"const": "rocm-7.14.0"}, "rocm_version": {"const": "7.14.0"}, "llvm_major": {"const": 23}, "compiler": {"const": "/opt/rocm/bin/amdclang++"}, "compiler_version": {"type": "string", "minLength": 1}, "paths": {"type": "object", "additionalProperties": false, "required": ["clang_offload_bundler", "llvm_objcopy", "llvm_readobj"], "properties": {"clang_offload_bundler": {"const": "/opt/rocm/lib/llvm/bin/clang-offload-bundler"}, "llvm_objcopy": {"const": "/opt/rocm/lib/llvm/bin/llvm-objcopy"}, "llvm_readobj": {"const": "/opt/rocm/lib/llvm/bin/llvm-readobj"}}}}}, "container": {"type": "object", "additionalProperties": false, "required": ["image_reference", "image_config_digest", "platform", "pinned", "network_isolated"], "properties": {"image_reference": {"type": "string"}, "image_config_digest": {"type": "string"}, "platform": {"const": {"os": "linux", "architecture": "amd64"}}, "pinned": {"type": "boolean"}, "network_isolated": {"type": "boolean"}}}, "codegen": {"$ref": "#/$defs/codegen"}, "logical_kernel": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "host_elf": {"$ref": "#/$defs/host"}, "device_code_object": {"$ref": "#/$defs/device"},
    "case_manifest": {"type": "object", "additionalProperties": false, "required": ["id", "selected_count", "collected_count"], "properties": {"id": {"const": "rmsnorm-h3-compile-link-extract-inspect-v1"}, "selected_count": {"const": 1}, "collected_count": {"const": 1}}}, "scope": {"type": "object", "additionalProperties": false, "required": ["compile_only", "execution_attempted", "gpu_execution", "model_used", "network_used", "fallback_allowed", "fallback_used", "cpu_fallback_used", "fake_hip", "emulation", "support_claim", "numerics_verified", "performance_verified"], "properties": {"compile_only": {"const": true}, "execution_attempted": {"const": false}, "gpu_execution": {"const": false}, "model_used": {"const": false}, "network_used": {"const": false}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}, "fake_hip": {"const": false}, "emulation": {"const": false}, "support_claim": {"const": false}, "numerics_verified": {"const": false}, "performance_verified": {"const": false}}}, "process": {"type": "object", "additionalProperties": false, "required": ["expected_children", "observed_children", "commands_expected", "commands_executed", "exit_codes", "timed_out", "crashed", "cleanup_proven"], "properties": {"expected_children": {"const": 1}, "observed_children": {"const": 1}, "commands_expected": {"type": "integer", "minimum": 1}, "commands_executed": {"type": "integer", "minimum": 1}, "exit_codes": {"type": "array", "items": {"const": 0}}, "timed_out": {"const": false}, "crashed": {"const": false}, "cleanup_proven": {"const": true}}}, "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at"], "properties": {"started_at": {"type": "string"}, "finished_at": {"type": "string"}}}
  }
}
