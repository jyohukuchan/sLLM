{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-g2-report-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "report_id", "row_id", "target", "state", "required", "candidate", "tree_oid", "model", "tolerance", "artifact", "scope", "device", "dispatch", "prerequisites", "cases", "health_pre", "health_post", "process_pre", "process_post", "execution", "collection"],
  "properties": {
    "schema_version": {"const": "rmsnorm-g2-report-v1"}, "report_id": {"type": "string", "minLength": 1},
    "row_id": {"enum": ["rmsnorm-g2-gfx1030", "rmsnorm-g2-gfx1201"]}, "target": {"enum": ["gfx1030", "gfx1201"]},
    "state": {"enum": ["PASS", "FAIL"]}, "required": {"const": true},
    "candidate": {"$ref": "#/$defs/candidate"}, "tree_oid": {"$ref": "#/$defs/sha40"},
    "model": {"$ref": "#/$defs/model"}, "tolerance": {"$ref": "#/$defs/tolerance"}, "artifact": {"$ref": "#/$defs/artifact"},
    "scope": {"$ref": "#/$defs/scope"}, "device": {"$ref": "#/$defs/device"}, "dispatch": {"$ref": "#/$defs/dispatch"}, "prerequisites": {"$ref": "#/$defs/prerequisites"},
    "cases": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/case"}},
    "health_pre": {"$ref": "#/$defs/health"}, "health_post": {"$ref": "#/$defs/health"}, "process_pre": {"$ref": "#/$defs/process"}, "process_post": {"$ref": "#/$defs/process"},
    "execution": {"$ref": "#/$defs/execution"}, "collection": {"$ref": "#/$defs/collection"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["used", "full_model_used", "tokenizer_used", "generation_used", "lock_path", "lock_sha256", "fingerprint", "resolved_revision", "slice"], "properties": {"used": {"const": true}, "full_model_used": {"const": false}, "tokenizer_used": {"const": false}, "generation_used": {"const": false}, "lock_path": {"const": "docs/models/locks/qwen3.5-4b-bf16.json"}, "lock_sha256": {"$ref": "#/$defs/sha256"}, "fingerprint": {"const": "sha256:f143d7b504170d071c77818105f7a07dc0297c6bea0c61a5404b071fed0c1fae"}, "resolved_revision": {"const": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"}, "slice": {"$ref": "#/$defs/slice"}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["tensor_name", "source_shard", "dtype", "shape", "header_length_bytes", "data_offsets", "absolute_byte_range", "size_bytes", "sha256", "recipe_sha256", "raw_stored"], "properties": {"tensor_name": {"const": "model.language_model.layers.0.input_layernorm.weight"}, "source_shard": {"const": "model.safetensors-00002-of-00002.safetensors"}, "dtype": {"const": "BF16"}, "shape": {"const": [2560]}, "header_length_bytes": {"const": 79064}, "data_offsets": {"const": [15360, 20480]}, "absolute_byte_range": {"const": [94432, 99552]}, "size_bytes": {"const": 5120}, "sha256": {"$ref": "#/$defs/sha256"}, "recipe_sha256": {"$ref": "#/$defs/sha256"}, "raw_stored": {"const": false}}},
    "tolerance": {"type": "object", "additionalProperties": false, "required": ["schema_path", "schema_sha256", "tolerance_id", "atol", "rtol"], "properties": {"schema_path": {"const": "ci/matrix/rmsnorm-g2-tolerance-v1.json"}, "schema_sha256": {"$ref": "#/$defs/sha256"}, "tolerance_id": {"const": "rmsnorm-bf16-f32-output-v1"}, "atol": {"const": 0.0078125}, "rtol": {"const": 0.015625}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_schema_path", "artifact_schema_sha256", "artifact_id", "binary_sha256", "binary_sidecar_sha256", "binary_source_sha256", "binary_source_set_sha256", "binary_role", "h3_or_g1_substitution"], "properties": {"artifact_schema_path": {"const": "ci/schema/rmsnorm-g2-artifact-v1.schema.json"}, "artifact_schema_sha256": {"$ref": "#/$defs/sha256"}, "artifact_id": {"type": "string", "minLength": 1}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "binary_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "binary_source_sha256": {"$ref": "#/$defs/sha256"}, "binary_source_set_sha256": {"$ref": "#/$defs/sha256"}, "binary_role": {"const": "dedicated-g2-runtime"}, "h3_or_g1_substitution": {"const": false}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["selected_backend", "model_used", "full_model_used", "tokenizer_used", "generation_used", "hip_only", "fallback_allowed", "fallback_used", "cpu_fallback_used", "dispatch_count"], "properties": {"selected_backend": {"const": "hip"}, "model_used": {"const": true}, "full_model_used": {"const": false}, "tokenizer_used": {"const": false}, "generation_used": {"const": false}, "hip_only": {"const": true}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}, "dispatch_count": {"type": "integer", "minimum": 0}}},
    "device": {"type": "object", "additionalProperties": false, "required": ["bdf", "uuid", "product", "target", "physical_hip_index", "logical_device_index"], "properties": {"bdf": {"type": "string", "minLength": 1}, "uuid": {"type": "string", "minLength": 1}, "product": {"type": "string", "minLength": 1}, "target": {"enum": ["gfx1030", "gfx1201"]}, "physical_hip_index": {"type": "integer", "minimum": 0}, "logical_device_index": {"const": 0}}},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["backend", "kernel_id", "kernel_symbol", "device_symbol", "dispatch_count", "workgroup_size_x", "fallback_allowed", "fallback_used"], "properties": {"backend": {"const": "hip"}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "dispatch_count": {"type": "integer", "minimum": 0}, "workgroup_size_x": {"const": 256}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["kind", "row_id", "state", "candidate_sha256", "artifact_sha256", "report_sha256"], "properties": {"kind": {"enum": ["g0", "private_g1", "semantic_g1", "h3"]}, "row_id": {"type": "string", "minLength": 1}, "state": {"const": "bound-not-executed-by-g2"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "report_sha256": {"$ref": "#/$defs/sha256"}}},
    "prerequisites": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/prerequisite"}},
    "case": {"type": "object", "additionalProperties": false, "required": ["order", "id", "rows", "n", "input_seed", "state", "request_sha256", "output_sha256", "reference_sha256", "classification", "dispatch_count", "fallback_used", "max_abs_error", "max_rel_error", "nan_count", "inf_count", "timeout", "crashed"], "properties": {"order": {"type": "integer", "minimum": 0, "maximum": 5}, "id": {"type": "string", "minLength": 1}, "rows": {"type": "integer", "minimum": 1}, "n": {"const": 2560}, "input_seed": {"type": "integer", "minimum": 0}, "state": {"enum": ["PASS", "FAIL"]}, "request_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "reference_sha256": {"$ref": "#/$defs/sha256"}, "classification": {"const": "finite"}, "dispatch_count": {"type": "integer", "minimum": 0}, "fallback_used": {"const": false}, "max_abs_error": {"type": "number", "minimum": 0}, "max_rel_error": {"type": "number", "minimum": 0}, "nan_count": {"const": 0}, "inf_count": {"const": 0}, "timeout": {"const": false}, "crashed": {"const": false}}},
    "health": {"type": "object", "additionalProperties": false, "required": ["available", "reliable", "state", "target", "ras_uncorrectable_count"], "properties": {"available": {"type": "boolean"}, "reliable": {"type": "boolean"}, "state": {"enum": ["OK", "UNAVAILABLE", "DEGRADED"]}, "target": {"enum": ["gfx1030", "gfx1201"]}, "ras_uncorrectable_count": {"type": "integer", "minimum": 0}}},
    "process": {"type": "object", "additionalProperties": false, "required": ["state", "residual_runner_children", "gpu_processes"], "properties": {"state": {"enum": ["CLEAN", "RESIDUAL"]}, "residual_runner_children": {"type": "array", "maxItems": 0, "items": false}, "gpu_processes": {"type": "array", "maxItems": 0, "items": false}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at", "duration_ns", "exit_code", "timed_out", "crashed", "binary_stdout_sha256", "binary_stderr_sha256", "failure_reason", "protocol_schema", "protocol_sha256"], "properties": {"started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "duration_ns": {"type": "integer", "minimum": 0}, "exit_code": {"type": "integer"}, "timed_out": {"type": "boolean"}, "crashed": {"type": "boolean"}, "binary_stdout_sha256": {"$ref": "#/$defs/sha256"}, "binary_stderr_sha256": {"$ref": "#/$defs/sha256"}, "failure_reason": {"type": "string"}, "protocol_schema": {"const": "rmsnorm-g2-runtime-result-v1"}, "protocol_sha256": {"$ref": "#/$defs/sha256"}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["expected_cases", "collected_cases", "passed_cases", "failed_cases", "expected_rows", "collected_rows"], "properties": {"expected_cases": {"const": 6}, "collected_cases": {"const": 6}, "passed_cases": {"type": "integer", "minimum": 0, "maximum": 6}, "failed_cases": {"type": "integer", "minimum": 0, "maximum": 6}, "expected_rows": {"const": 1}, "collected_rows": {"const": 1}}}
  }
}
