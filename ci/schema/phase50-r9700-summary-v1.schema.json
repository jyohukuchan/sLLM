{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase50-r9700-summary-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "target", "gpu_uuid", "gpu_bdf", "inputs", "identities", "matrix", "rows", "gate"],
  "properties": {
    "schema_version": {"const": "phase50-r9700-summary-v1"},
    "state": {"enum": ["PASS", "FAIL"]},
    "target": {"const": "gfx1201"},
    "gpu_uuid": {"const": "GPU-a8e9ddefa2d60f55"},
    "gpu_bdf": {"const": "0000:07:00.0"},
    "inputs": {
      "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
      "properties": {
        "sllm": {"$ref": "#/$defs/input"},
        "llama": {"$ref": "#/$defs/input"}
      }
    },
    "identities": {
      "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
      "properties": {
        "sllm": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "engine", "backend", "target", "gpu_uuid", "gpu_bdf"],
          "properties": {
            "schema_version": {"const": "phase50-r9700-sllm-v1"}, "engine": {"const": "sllm"}, "backend": {"const": "hip"},
            "target": {"const": "gfx1201"}, "gpu_uuid": {"const": "GPU-a8e9ddefa2d60f55"}, "gpu_bdf": {"const": "0000:07:00.0"}
          }
        },
        "llama": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "engine", "commit", "tag", "target", "gpu_uuid", "gpu_bdf"],
          "properties": {
            "schema_version": {"const": "phase50-r9700-llama-v1"}, "engine": {"const": "llama.cpp"},
            "commit": {"const": "3cb7ffb1a1f612d5e4a46244ae5a3c77ad934a70"}, "tag": {"const": "b10453"},
            "target": {"const": "gfx1201"}, "gpu_uuid": {"const": "GPU-a8e9ddefa2d60f55"}, "gpu_bdf": {"const": "0000:07:00.0"}
          }
        }
      }
    },
    "matrix": {
      "type": "object", "additionalProperties": false, "required": ["cases", "row_count"],
      "properties": {
        "cases": {"type": "array", "const": ["short-odd", "32-32", "prefill-long", "decode-long", "long-10001", "long-100000", "decode-20000"]},
        "row_count": {"const": 7}
      }
    },
    "failure_count": {"type": "integer", "minimum": 1},
    "failures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failure"}},
    "rows": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/row"}},
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["formula", "e2e", "ttft", "tpot", "all_pass"],
      "properties": {
        "formula": {"const": "sLLM median <= llama.cpp median + max(sLLM MAD, llama.cpp MAD)"},
        "e2e": {"type": "boolean"}, "ttft": {"type": "boolean"}, "tpot": {"type": "boolean"}, "all_pass": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "PASS"}}}, "then": {"properties": {"gate": {"properties": {"all_pass": {"const": true}}}}}},
    {"if": {"properties": {"state": {"const": "FAIL"}}}, "then": {"properties": {"gate": {"properties": {"all_pass": {"const": false}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "stats": {
      "type": "object", "additionalProperties": false, "required": ["median", "mad", "count", "min", "max"],
      "properties": {
        "median": {"type": "number", "exclusiveMinimum": 0}, "mad": {"type": "number", "minimum": 0},
        "count": {"type": "integer", "minimum": 1, "maximum": 10}, "min": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "metric_gate": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["sllm_median", "sllm_mad", "llama_median", "llama_mad", "limit", "pass"],
      "properties": {
        "sllm_median": {"type": "number", "exclusiveMinimum": 0}, "sllm_mad": {"type": "number", "minimum": 0},
        "llama_median": {"type": "number", "exclusiveMinimum": 0}, "llama_mad": {"type": "number", "minimum": 0},
        "limit": {"type": "number", "exclusiveMinimum": 0}, "pass": {"type": ["boolean", "null"]}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "input_token_count", "requested_output_tokens", "protocol", "row_ids", "measured_sample_count", "tokens", "metrics", "gates"],
      "properties": {
        "case_id": {"enum": ["short-odd", "32-32", "prefill-long", "decode-long", "long-10001", "long-100000", "decode-20000"]},
        "input_token_count": {"type": "integer", "minimum": 1}, "requested_output_tokens": {"type": "integer", "minimum": 1},
        "protocol": {"$ref": "#/$defs/protocol"},
        "row_ids": {
          "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
          "properties": {"sllm": {"type": "string", "minLength": 1, "maxLength": 256}, "llama": {"type": "string", "minLength": 1, "maxLength": 256}}
        },
        "measured_sample_count": {
          "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
          "properties": {"sllm": {"type": "integer", "minimum": 0, "maximum": 10}, "llama": {"type": "integer", "minimum": 0, "maximum": 10}}
        },
        "tokens": {
          "type": "object", "additionalProperties": false,
          "required": ["input_sha256", "generated_sha256", "visible_sha256", "stop_sha256", "generated_equal", "visible_equal", "stop_equal"],
          "properties": {
            "input_sha256": {"$ref": "#/$defs/sha256"},
            "generated_sha256": {"$ref": "#/$defs/engine_sha"}, "visible_sha256": {"$ref": "#/$defs/engine_sha"}, "stop_sha256": {"$ref": "#/$defs/engine_sha"},
            "generated_equal": {"type": ["boolean", "null"]}, "visible_equal": {"type": ["boolean", "null"]}, "stop_equal": {"type": ["boolean", "null"]}
          }
        },
        "metrics": {
          "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
          "properties": {
            "sllm": {"$ref": "#/$defs/engine_stats"}, "llama": {"$ref": "#/$defs/engine_stats"}
          }
        },
        "gates": {
          "type": "object", "additionalProperties": false, "required": ["e2e_ns", "ttft_ns", "tpot_ns"],
          "properties": {"e2e_ns": {"$ref": "#/$defs/metric_gate"}, "ttft_ns": {"$ref": "#/$defs/metric_gate"}, "tpot_ns": {"$ref": "#/$defs/metric_gate"}}
        },
        "failures": {"$ref": "#/$defs/row_failures"}
      },
      "allOf": [
        {"oneOf": [
          {"properties": {"case_id": {"const": "short-odd"}, "input_token_count": {"const": 17}, "requested_output_tokens": {"const": 17}, "protocol": {"allOf": [{"$ref": "#/$defs/normal_protocol"}, {"properties": {"context_length": {"const": 34}}}]}}},
          {"properties": {"case_id": {"const": "32-32"}, "input_token_count": {"const": 32}, "requested_output_tokens": {"const": 32}, "protocol": {"allOf": [{"$ref": "#/$defs/normal_protocol"}, {"properties": {"context_length": {"const": 64}}}]}}},
          {"properties": {"case_id": {"const": "prefill-long"}, "input_token_count": {"const": 1024}, "requested_output_tokens": {"const": 128}, "protocol": {"allOf": [{"$ref": "#/$defs/normal_protocol"}, {"properties": {"context_length": {"const": 1152}}}]}}},
          {"properties": {"case_id": {"const": "decode-long"}, "input_token_count": {"const": 32}, "requested_output_tokens": {"const": 256}, "protocol": {"allOf": [{"$ref": "#/$defs/normal_protocol"}, {"properties": {"context_length": {"const": 288}}}]}}},
          {"properties": {"case_id": {"const": "long-10001"}, "input_token_count": {"const": 10001}, "requested_output_tokens": {"const": 2}, "protocol": {"allOf": [{"$ref": "#/$defs/normal_protocol"}, {"properties": {"context_length": {"const": 10003}}}]}}},
          {"properties": {"case_id": {"const": "long-100000"}, "input_token_count": {"const": 100000}, "requested_output_tokens": {"const": 2}, "protocol": {"$ref": "#/$defs/extended_protocol"}}},
          {"properties": {"case_id": {"const": "decode-20000"}, "input_token_count": {"const": 32}, "requested_output_tokens": {"const": 20000}, "protocol": {"$ref": "#/$defs/extended_ignore_eos_protocol"}}}
        ]}
      ]
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["warmups", "measured", "context_length", "ignore_eos"],
      "properties": {"warmups": {"enum": [1, 3]}, "measured": {"enum": [3, 10]}, "context_length": {"type": "integer", "minimum": 1}, "ignore_eos": {"type": "boolean"}}
    },
    "normal_protocol": {
      "allOf": [{"$ref": "#/$defs/protocol"}, {"properties": {"warmups": {"const": 3}, "measured": {"const": 10}, "ignore_eos": {"const": false}}}]
    },
    "extended_protocol": {
      "allOf": [{"$ref": "#/$defs/protocol"}, {"properties": {"warmups": {"const": 1}, "measured": {"const": 3}, "context_length": {"const": 131072}, "ignore_eos": {"const": false}}}]
    },
    "extended_ignore_eos_protocol": {
      "allOf": [{"$ref": "#/$defs/protocol"}, {"properties": {"warmups": {"const": 1}, "measured": {"const": 3}, "context_length": {"const": 131072}, "ignore_eos": {"const": true}}}]
    },
    "engine_sha": {
      "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
      "properties": {"sllm": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "llama": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "engine_stats": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["e2e_ns", "ttft_ns", "tpot_ns"],
      "properties": {"e2e_ns": {"$ref": "#/$defs/stats"}, "ttft_ns": {"$ref": "#/$defs/stats"}, "tpot_ns": {"$ref": "#/$defs/stats"}}
    },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["engine", "case_id", "row_id", "kind", "reason"],
      "properties": {
        "engine": {"enum": ["sllm", "llama"]},
        "case_id": {"enum": ["short-odd", "32-32", "prefill-long", "decode-long", "long-10001", "long-100000", "decode-20000"]},
        "row_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "row_failure": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["kind", "reason"],
      "properties": {"kind": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "row_failures": {
      "type": "object", "additionalProperties": false, "required": ["sllm", "llama"],
      "properties": {"sllm": {"$ref": "#/$defs/row_failure"}, "llama": {"$ref": "#/$defs/row_failure"}}
    }
  }
}
