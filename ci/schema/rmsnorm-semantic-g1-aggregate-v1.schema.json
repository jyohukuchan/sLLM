    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_manifest_sha256", "matrix_schema_sha256", "artifact_schema_sha256", "report_schema_sha256", "aggregate_schema_sha256", "model_lock_sha256"],
      "properties": {
        "matrix_manifest_sha256": {"$ref": "#/$defs/exact_digest"},
        "matrix_schema_sha256": {"$ref": "#/$defs/exact_digest"},
        "artifact_schema_sha256": {"$ref": "#/$defs/exact_digest"},
        "report_schema_sha256": {"$ref": "#/$defs/exact_digest"},
