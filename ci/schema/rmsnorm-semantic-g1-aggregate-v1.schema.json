          "properties": {
            "cargo": {"$ref": "#/$defs/record"},
            "rustc": {"$ref": "#/$defs/record"},
            "cmake": {"$ref": "#/$defs/record"},
            "cxx": {"$ref": "#/$defs/record"},
            "objcopy": {"$ref": "#/$defs/record"},
            "bundler": {"$ref": "#/$defs/record"},
            "amd_smi": {"$ref": "#/$defs/record"},
            "process_limiter": {"$ref": "#/$defs/record"},
            "loader": {"$ref": "#/$defs/record"},
            "hip_runtime": {"$ref": "#/$defs/record"},
            "hsa_runtime": {"$ref": "#/$defs/record"}
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_rows", "selected_rows", "collected_rows", "passed_rows", "failed_rows"],
      "properties": {
        "expected_rows": {"const": 2},
        "selected_rows": {"const": 2},
        "collected_rows": {"const": 2},
        "passed_rows": {"const": 2},
        "failed_rows": {"const": 0}
      }
    },
    "sealed_input_view": {"type": "object", "additionalProperties": false, "required": ["algorithm", "argv", "argv_sha256", "inputs", "include_directories", "sealed"], "properties": {"algorithm": {"const": "sealed-input-view-v1"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "argv_sha256": {"$ref": "#/$defs/exact_digest"}, "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "resolved_path", "size_bytes", "sha256", "device", "inode", "view_fd"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"}, "resolved_path": {"type": "string", "pattern": "^/"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/exact_digest"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "view_fd": {"type": "integer", "minimum": 3}}}}, "include_directories": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["original", "view"], "properties": {"original": {"type": "string"}, "view": {"type": "string", "pattern": "^/tmp/sllm-exact-input-view-"}}}}, "sealed": {"const": true}}},
    "exact_directory": {"type": "object", "additionalProperties": false, "required": ["path", "resolved_path", "device", "inode"], "properties": {"path": {"type": "string", "pattern": "^/"}, "resolved_path": {"type": "string", "pattern": "^/"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}}},
    "exact_executable": {"type": "object", "additionalProperties": false, "required": ["path", "resolved_path", "size_bytes", "sha256", "device", "inode", "seals"], "properties": {"path": {"type": "string", "pattern": "^/"}, "resolved_path": {"type": "string", "pattern": "^/"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/exact_digest"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "seals": {"type": "integer", "minimum": 1}}},
    "exact_input": {"type": "object", "additionalProperties": false, "required": ["role", "path", "resolved_path", "size_bytes", "sha256", "device", "inode"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"}, "resolved_path": {"type": "string", "pattern": "^/"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/exact_digest"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}}},
    "exact_implicit": {"type": "object", "additionalProperties": false, "required": ["role", "size_bytes", "sha256", "bytes_hex"], "properties": {"role": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/exact_digest"}, "bytes_hex": {"type": "string", "pattern": "^[0-9a-f]*$"}}},
    "exact_output": {"type": "object", "additionalProperties": false, "required": ["path", "parent"], "properties": {"path": {"type": "string", "pattern": "^/"}, "parent": {"$ref": "#/$defs/exact_directory"}}},
    "exact_binding": {"type": "object", "additionalProperties": false, "required": ["pid", "starttime", "uid", "gid"], "properties": {"pid": {"type": "integer", "minimum": 1}, "starttime": {"type": "integer", "minimum": 1}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}}},
    "response_evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sidecar_path", "size_bytes", "sha256", "sidecar_sha256", "candidate_sha256", "row_id", "case_id", "order"], "properties": {"path": {"type": "string", "pattern": "^rows/rmsnorm-semantic-g1-(?:gfx1030|gfx1201)/raw/case-[0-9]+\\.bin$"}, "sidecar_path": {"type": "string", "pattern": "^rows/rmsnorm-semantic-g1-(?:gfx1030|gfx1201)/raw/case-[0-9]+\\.bin\\.sha256$"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/exact_digest"}, "sidecar_sha256": {"$ref": "#/$defs/exact_digest"}, "candidate_sha256": {"$ref": "#/$defs/exact_digest"}, "row_id": {"type": "string", "enum": ["rmsnorm-semantic-g1-gfx1030", "rmsnorm-semantic-g1-gfx1201"]}, "case_id": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 0, "maximum": 14}}},
    "exact_action_manifest": {"type": "object", "additionalProperties": false, "required": ["schema_version", "action_id", "manifest_digest", "executable", "argv0", "argv", "cwd", "environment", "inputs", "implicit", "response_files", "outputs", "target", "occurrence_index", "occurrence_limit"], "properties": {"schema_version": {"const": "exact-parent-action-manifest-v1"}, "action_id": {"$ref": "#/$defs/exact_digest"}, "manifest_digest": {"$ref": "#/$defs/exact_digest"}, "executable": {"$ref": "#/$defs/exact_executable"}, "argv0": {"type": "string", "minLength": 1}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"$ref": "#/$defs/exact_directory"}, "environment": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string"}], "items": false}}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/exact_input"}}, "implicit": {"type": "array", "items": {"$ref": "#/$defs/exact_implicit"}}, "response_files": {"type": "array", "items": {"$ref": "#/$defs/exact_implicit"}}, "outputs": {"type": "array", "items": {"$ref": "#/$defs/exact_output"}}, "target": {"type": "string", "minLength": 1}, "occurrence_index": {"const": 0}, "occurrence_limit": {"const": 1}}},
    "exact_exec_identity": {"type": "object", "additionalProperties": false, "required": ["pid", "starttime", "ppid", "pgrp", "exe_dev", "exe_ino", "sealed_dev", "sealed_ino", "exe_path", "argv_sha256", "cwd", "exec_ready"], "properties": {"pid": {"type": "integer", "minimum": 1}, "starttime": {"type": "integer", "minimum": 1}, "ppid": {"type": "integer", "minimum": 1}, "pgrp": {"type": "integer", "minimum": 1}, "exe_dev": {"type": "integer", "minimum": 1}, "exe_ino": {"type": "integer", "minimum": 1}, "sealed_dev": {"type": "integer", "minimum": 1}, "sealed_ino": {"type": "integer", "minimum": 1}, "exe_path": {"type": "string", "pattern": "^/proc/[0-9]+/exe$"}, "argv_sha256": {"$ref": "#/$defs/exact_digest"}, "cwd": {"type": "string", "pattern": "^/"}, "exec_ready": {"const": true}}},
