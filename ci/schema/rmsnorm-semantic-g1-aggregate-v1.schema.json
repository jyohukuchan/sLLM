            "copy_count": {"type": "integer", "minimum": 0},
            "dispatch_count": {"type": "integer", "minimum": 0},
            "kernel_count": {"type": "integer", "minimum": 0}
          }
        },
        "compiler_execution_sha256": {"$ref": "#/$defs/exact_digest"},
        "compiler_execution": {"$ref": "#/$defs/exact_action_transcript"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_sha",
        "tested_sha",
        "workflow_sha",
        "git_tree_oid",
        "git_object_format",
        "git_oid_width",
        "worktree_clean",
        "revision_input"
      ],
      "properties": {
        "reviewed_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tested_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "workflow_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "git_tree_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
