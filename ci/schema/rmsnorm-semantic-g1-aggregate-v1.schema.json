      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "target",
        "state",
        "report_sha256",
        "binary_sha256",
        "companion_sha256",
        "loader_sha256",
        "runtime_library_sha256",
        "runtime_dependency_closure_sha256",
        "raw_frame_sha256",
        "response_evidence",
        "resource_counts",
        "compiler_execution_sha256",
        "compiler_execution"
      ],
      "properties": {
        "row_id": {"enum": ["rmsnorm-semantic-g1-gfx1030", "rmsnorm-semantic-g1-gfx1201"]},
        "target": {"enum": ["gfx1030", "gfx1201"]},
        "state": {"enum": ["PASS", "FAIL"]},
        "report_sha256": {"$ref": "#/$defs/exact_digest"},
        "binary_sha256": {"$ref": "#/$defs/exact_digest"},
        "companion_sha256": {"$ref": "#/$defs/exact_digest"},
        "loader_sha256": {"$ref": "#/$defs/exact_digest"},
        "runtime_library_sha256": {"$ref": "#/$defs/exact_digest"},
        "runtime_dependency_closure_sha256": {"$ref": "#/$defs/exact_digest"},
        "raw_frame_sha256": {"$ref": "#/$defs/exact_digest"},
