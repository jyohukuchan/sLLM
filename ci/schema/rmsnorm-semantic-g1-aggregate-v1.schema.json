{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-semantic-g1-aggregate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_id",
    "suite_id",
    "tier",
    "state",
    "required",
    "run_id",
    "run_attempt",
    "candidate",
    "authority",
    "contracts",
    "artifact_kind",
    "expected_rows",
    "rows",
    "scope",
    "counts",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "rmsnorm-semantic-g1-aggregate-v1"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "artifact_kind": {
      "type": "string"
    },
    "expected_rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "rmsnorm-semantic-g1-gfx1030"},
        {"const": "rmsnorm-semantic-g1-gfx1201"}
      ],
      "items": false
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/aggregate_row"},
            {"properties": {"row_id": {"const": "rmsnorm-semantic-g1-gfx1030"}, "target": {"const": "gfx1030"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/aggregate_row"},
            {"properties": {"row_id": {"const": "rmsnorm-semantic-g1-gfx1201"}, "target": {"const": "gfx1201"}}}
          ]
        }
      ],
      "items": false
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
