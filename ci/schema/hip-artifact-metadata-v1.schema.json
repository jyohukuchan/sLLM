{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ullm-project.local/ci/schema/hip-artifact-metadata-v1.schema.json",
  "title": "uLLM HIP compile-only artifact metadata v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date_time_z": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "execution_scope", "container_image_reference",
        "observed_image_config_digest", "pinned_container", "identity_verified",
        "network_isolated"
      ],
      "properties": {
        "mode": {"enum": ["required-ci", "local-development"]},
        "execution_scope": {"enum": ["official-container", "local-system"]},
        "container_image_reference": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9./_-]+@sha256:[0-9a-f]{64}$"
        },
        "observed_image_config_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pinned_container": {"type": "boolean"},
        "identity_verified": {"type": "boolean"},
        "network_isolated": {"type": "boolean"}
      }
    },
    "absolute_source_path": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "tag", "manifest_digest", "config_digest",
        "manifest_list_digest", "manifest_type", "platform"
      ],
      "properties": {
        "repository": {"const": "docker.io/rocm/dev-ubuntu-24.04"},
        "tag": {"const": "7.14.0-full"},
        "manifest_digest": {"const": "sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7"},
        "config_digest": {"const": "sha256:4c91c0d850e38a40fd669dd043ab42e9bad9a2b8a38e3f873c5a4eaced9f28cf"},
        "manifest_list_digest": {"const": null},
        "manifest_type": {"const": "application/vnd.docker.distribution.manifest.v2+json"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {"os": {"const": "linux"}, "architecture": {"const": "amd64"}}
        }
      }
    },
    "resolved_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rocm_root", "compiler", "hip_headers", "hip_cmake_package", "device_libraries", "hip_runtime", "clang_offload_bundler", "llvm_objcopy", "llvm_readobj", "llvm_objdump"],
      "properties": {
        "rocm_root": {"const": "/opt/rocm"},
        "compiler": {"const": "/opt/rocm/bin/amdclang++"},
        "hip_headers": {"const": "/opt/rocm/include"},
        "hip_cmake_package": {"const": "/opt/rocm/lib/cmake/hip"},
        "device_libraries": {"const": "/opt/rocm/amdgcn/bitcode"},
        "hip_runtime": {"const": "/opt/rocm/lib/libamdhip64.so"},
        "clang_offload_bundler": {"const": "/opt/rocm/lib/llvm/bin/clang-offload-bundler"},
        "llvm_objcopy": {"const": "/opt/rocm/lib/llvm/bin/llvm-objcopy"},
        "llvm_readobj": {"const": "/opt/rocm/lib/llvm/bin/llvm-readobj"},
        "llvm_objdump": {"const": "/opt/rocm/lib/llvm/bin/llvm-objdump"}
      }
    },
    "codegen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "target_kind", "target_count", "code_object_version", "wavefront_size", "features"],
      "properties": {
        "target": {"enum": ["gfx1030", "gfx1201"]},
        "target_kind": {"const": "exact"},
        "target_count": {"const": 1},
        "code_object_version": {"const": "V6"},
        "wavefront_size": {"const": 32},
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xnack", "sramecc", "generic_processor_version"],
          "properties": {
            "xnack": {"const": "unsupported"},
            "sramecc": {"const": "unsupported"},
            "generic_processor_version": {"const": 0}
          }
        }
      }
    },
    "host_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target"],
      "properties": {
        "id": {"enum": ["hipv4-amdgcn-amd-amdhsa--gfx1030", "hipv4-amdgcn-amd-amdhsa--gfx1201", "host-x86_64-unknown-linux-gnu-"]},
        "target": {"enum": ["gfx1030", "gfx1201", "host"]}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "size_bytes"],
      "properties": {"present": {"const": true}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}}
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "defined"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "defined": {"const": true}
      }
    },
    "host_bundle_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "machine", "bundles", "sections"],
      "properties": {
        "format": {"const": "ELF64"},
        "machine": {"const": "X86_64"},
        "bundles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/host_bundle"}
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [".hip_fatbin"],
          "properties": {
            ".text": {"$ref": "#/$defs/section"},
            ".hip_fatbin": {"$ref": "#/$defs/section"}
          }
        }
      }
    },
    "device_code_object_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "machine", "target", "ei_abiversion", "e_flags",
        "code_object_version", "wavefront_size", "features", "sections", "symbols"
      ],
      "properties": {
        "format": {"const": "ELF64"},
        "machine": {"const": "AMDGPU"},
        "target": {"enum": ["gfx1030", "gfx1201"]},
        "ei_abiversion": {"const": 4},
        "e_flags": {"enum": ["0x00000036", "0x0000004e"]},
        "code_object_version": {"const": "V6"},
        "wavefront_size": {"const": 32},
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xnack", "sramecc", "generic_processor_version"],
          "properties": {
            "xnack": {"const": "unsupported"},
            "sramecc": {"const": "unsupported"},
            "generic_processor_version": {"const": 0}
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [".text"],
          "properties": {".text": {"$ref": "#/$defs/section"}}
        },
        "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}}
      }
    }
  },
  "required": [
    "schema_version", "metadata_id", "matrix_row_id", "target", "candidate",
    "toolchain_id", "matrix_id", "toolchain_manifest_sha256", "matrix_manifest_sha256",
    "image", "resolved_paths", "build", "codegen", "artifact", "host_bundle", "device_code_object", "scope",
    "execution_environment",
    "timestamps", "duration_seconds"
  ],
  "properties": {
    "schema_version": {"const": "hip-artifact-metadata-v1"},
    "metadata_id": {"pattern": "^h3-artifact-(?:gfx1030|gfx1201)$", "type": "string"},
    "matrix_row_id": {"enum": ["h3-gfx1030", "h3-gfx1201"]},
    "target": {"enum": ["gfx1030", "gfx1201"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_oid", "reviewed_sha", "tested_sha", "workflow_sha"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "tree_oid": {"$ref": "#/$defs/sha40"},
        "reviewed_sha": {"$ref": "#/$defs/sha40"},
        "tested_sha": {"$ref": "#/$defs/sha40"},
        "workflow_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "toolchain_id": {"const": "rocm-7.14.0"},
    "matrix_id": {"const": "hip-compile-v1"},
    "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "image": {"$ref": "#/$defs/image"},
    "resolved_paths": {"$ref": "#/$defs/resolved_paths"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_directory", "source_path", "output_directory", "object_path", "link_output_path",
        "generator", "mode", "build_type", "language_standard",
        "output_directory_scope", "source_tree_output", "shared_build_directory"
      ],
      "properties": {
        "source_directory": {"$ref": "#/$defs/absolute_source_path"},
        "source_path": {"pattern": "^/(?:workspace|[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*)/native/hip/src/hip_compile_probe\\.hip\\.cpp$", "type": "string"},
        "output_directory": {"pattern": "^/tmp/ullm-h3-[A-Za-z0-9._-]+/h3-gfx(?:1030|1201)$", "type": "string"},
        "object_path": {"pattern": "^/tmp/ullm-h3-[A-Za-z0-9._-]+/h3-gfx(?:1030|1201)/hip-compile-probe-gfx(?:1030|1201)\\.o$", "type": "string"},
        "link_output_path": {"pattern": "^/tmp/ullm-h3-[A-Za-z0-9._-]+/h3-gfx(?:1030|1201)/hip-compile-probe-gfx(?:1030|1201)\\.elf$", "type": "string"},
        "generator": {"const": "direct-amdclang++"},
        "mode": {"const": "direct-compile-link"},
        "build_type": {"const": "Release"},
        "language_standard": {"const": "gnu++17"},
        "output_directory_scope": {"const": "row-private"},
        "source_tree_output": {"const": false},
        "shared_build_directory": {"const": false}
      }
    },
    "codegen": {"$ref": "#/$defs/codegen"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"pattern": "^/tmp/ullm-h3-[A-Za-z0-9._-]+/h3-gfx(?:1030|1201)/[A-Za-z0-9_.+-]+-gfx(?:1030|1201)\\.elf$", "type": "string"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_bundle": {"$ref": "#/$defs/host_bundle_evidence"},
    "device_code_object": {"$ref": "#/$defs/device_code_object_evidence"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compile_only", "link_verified", "gpu_execution", "execution_attempted",
        "numerics_verified", "model_verified", "performance_verified", "support_claim",
        "network_used", "model_used", "cpu_fallback_used"
      ],
      "properties": {
        "compile_only": {"const": true},
        "link_verified": {"const": true},
        "gpu_execution": {"const": false},
        "execution_attempted": {"const": false},
        "numerics_verified": {"const": false},
        "model_verified": {"const": false},
        "performance_verified": {"const": false},
        "support_claim": {"const": false},
        "network_used": {"const": false},
        "model_used": {"const": false},
        "cpu_fallback_used": {"const": false}
      }
    },
    "execution_environment": {"$ref": "#/$defs/execution_environment"},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "started_at", "finished_at"],
      "properties": {
        "created_at": {"$ref": "#/$defs/date_time_z"},
        "started_at": {"$ref": "#/$defs/date_time_z"},
        "finished_at": {"$ref": "#/$defs/date_time_z"}
      }
    },
    "duration_seconds": {"type": "number", "minimum": 0, "maximum": 900}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_environment": {
            "properties": {"mode": {"const": "required-ci"}}
          }
        }
      },
      "then": {
        "properties": {
          "execution_environment": {
            "properties": {
              "execution_scope": {"const": "official-container"},
              "container_image_reference": {"const": "docker.io/rocm/dev-ubuntu-24.04@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7"},
              "observed_image_config_digest": {"const": "sha256:4c91c0d850e38a40fd669dd043ab42e9bad9a2b8a38e3f873c5a4eaced9f28cf"},
              "pinned_container": {"const": true},
              "identity_verified": {"const": true},
              "network_isolated": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_environment": {
            "properties": {"mode": {"const": "local-development"}}
          }
        }
      },
      "then": {
        "properties": {
          "execution_environment": {
            "properties": {
              "execution_scope": {"const": "local-system"},
              "container_image_reference": {"const": null},
              "observed_image_config_digest": {"const": null},
              "pinned_container": {"const": false},
              "identity_verified": {"const": false},
              "network_isolated": {"const": false}
            }
          }
        }
      }
    }
  ]
}
