{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-h3-report-v1.schema.json",
  "title": "sLLM dedicated RMSNorm H3 row report v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_set": {"type": "object", "additionalProperties": false, "required": ["canonical_order", "files", "source_set_sha256"], "properties": {"canonical_order": {"type": "array", "items": {"type": "string"}}, "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}}, "source_set_sha256": {"$ref": "#/$defs/sha256"}}},
    "codegen": {"type": "object", "additionalProperties": false, "required": ["target", "target_kind", "target_count", "code_object_version", "wavefront_size", "features", "e_flags"], "properties": {"target": {"enum": ["gfx1030", "gfx1201"]}, "target_kind": {"const": "exact"}, "target_count": {"const": 1}, "code_object_version": {"const": "V6"}, "wavefront_size": {"const": 32}, "features": {"type": "object", "additionalProperties": false, "required": ["xnack", "sramecc", "generic_processor_version"], "properties": {"xnack": {"const": "unsupported"}, "sramecc": {"const": "unsupported"}, "generic_processor_version": {"const": 0}}}, "e_flags": {"enum": ["0x00000036", "0x0000004e"]}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["compile_only", "execution_attempted", "gpu_execution", "model_used", "network_used", "fallback_allowed", "fallback_used", "cpu_fallback_used", "fake_hip", "emulation", "support_claim", "numerics_verified", "performance_verified"], "properties": {"compile_only": {"const": true}, "execution_attempted": {"const": false}, "gpu_execution": {"const": false}, "model_used": {"const": false}, "network_used": {"const": false}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}, "fake_hip": {"const": false}, "emulation": {"const": false}, "support_claim": {"const": false}, "numerics_verified": {"const": false}, "performance_verified": {"const": false}}}
  },
  "required": ["schema_version", "report_id", "suite_id", "tier", "state", "required", "evidence_mode", "run_id", "run_attempt", "reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "matrix_id", "matrix_manifest_sha256", "workflow_file_sha256", "schema_digests", "row_id", "target", "source_sets", "source_symbol_map", "toolchain", "container", "codegen", "logical_kernel", "device_symbol", "scope", "case_manifest", "process", "artifact", "steps", "diagnostics", "timestamps"],
  "properties": {
    "schema_version": {"const": "rmsnorm-h3-report-v1"}, "report_id": {"type": "string", "pattern": "^rmsnorm-h3-report-[a-z0-9]+$"}, "suite_id": {"const": "h3-rmsnorm-compile-only"}, "tier": {"const": "tier_h3_rmsnorm"}, "state": {"const": "PASS"}, "required": {"const": false}, "evidence_mode": {"enum": ["required-ci", "local-nonstrict"]}, "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1}, "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"type": "boolean"}, "matrix_id": {"const": "rmsnorm-h3-compile-v1"}, "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"}, "workflow_file_sha256": {"$ref": "#/$defs/sha256"}, "schema_digests": {"type": "object", "additionalProperties": false, "required": ["compile", "artifact", "report", "aggregate"], "properties": {"compile": {"$ref": "#/$defs/sha256"}, "artifact": {"$ref": "#/$defs/sha256"}, "report": {"$ref": "#/$defs/sha256"}, "aggregate": {"$ref": "#/$defs/sha256"}}}, "row_id": {"pattern": "^h3-rmsnorm-gfx(?:1030|1201)$", "type": "string"}, "target": {"enum": ["gfx1030", "gfx1201"]}, "source_sets": {"type": "object", "additionalProperties": false, "required": ["device", "host_abi", "binding_build", "ci_contract"], "properties": {"device": {"$ref": "#/$defs/source_set"}, "host_abi": {"$ref": "#/$defs/source_set"}, "binding_build": {"$ref": "#/$defs/source_set"}, "ci_contract": {"$ref": "#/$defs/source_set"}}}, "source_symbol_map": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["path", "symbol", "role"], "properties": {"path": {"type": "string"}, "symbol": {"type": "string"}, "role": {"type": "string"}}}}, "toolchain": {"type": "object", "additionalProperties": false, "required": ["id", "compiler", "compiler_version", "llvm_major"], "properties": {"id": {"const": "rocm-7.14.0"}, "compiler": {"const": "/opt/rocm/bin/amdclang++"}, "compiler_version": {"type": "string"}, "llvm_major": {"const": 23}}}, "container": {"type": "object", "additionalProperties": false, "required": ["image_reference", "image_config_digest", "platform", "pinned", "network_isolated"], "properties": {"image_reference": {"type": "string"}, "image_config_digest": {"type": "string"}, "platform": {"const": {"os": "linux", "architecture": "amd64"}}, "pinned": {"type": "boolean"}, "network_isolated": {"type": "boolean"}}}, "codegen": {"$ref": "#/$defs/codegen"}, "logical_kernel": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "scope": {"$ref": "#/$defs/scope"}, "case_manifest": {"type": "object", "additionalProperties": false, "required": ["id", "selected_count", "collected_count"], "properties": {"id": {"const": "rmsnorm-h3-compile-link-extract-inspect-v1"}, "selected_count": {"const": 1}, "collected_count": {"const": 1}}}, "process": {"type": "object", "additionalProperties": false, "required": ["expected_children", "observed_children", "commands_expected", "commands_executed", "exit_codes", "timed_out", "crashed", "cleanup_proven"], "properties": {"expected_children": {"const": 1}, "observed_children": {"const": 1}, "commands_expected": {"type": "integer", "minimum": 1}, "commands_executed": {"type": "integer", "minimum": 1}, "exit_codes": {"type": "array", "items": {"const": 0}}, "timed_out": {"const": false}, "crashed": {"const": false}, "cleanup_proven": {"const": true}}}, "artifact": {"type": "object", "additionalProperties": false, "required": ["metadata", "metadata_sha256", "metadata_sidecar_sha256", "host_elf_sha256", "device_code_object_sha256", "host_elf_sidecar_sha256", "device_code_object_sidecar_sha256"], "properties": {"metadata": {"const": "rmsnorm-h3-artifact.json"}, "metadata_sha256": {"$ref": "#/$defs/sha256"}, "metadata_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "host_elf_sha256": {"$ref": "#/$defs/sha256"}, "device_code_object_sha256": {"$ref": "#/$defs/sha256"}, "host_elf_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "device_code_object_sidecar_sha256": {"$ref": "#/$defs/sha256"}}}, "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["step_id", "state", "exit_code"], "properties": {"step_id": {"type": "string"}, "state": {"const": "PASS"}, "exit_code": {"const": 0}}}}, "diagnostics": {"type": "array", "maxItems": 0, "items": {"type": "string"}}, "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at"], "properties": {"started_at": {"type": "string"}, "finished_at": {"type": "string"}}}
  }
}
