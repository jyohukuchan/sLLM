{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-h3-compile-v1.schema.json",
  "title": "sLLM dedicated RMSNorm H3 compile-only matrix v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_set": {"type": "object", "additionalProperties": false, "required": ["canonical_order", "files", "source_set_sha256"], "properties": {"canonical_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}, "source_set_sha256": {"$ref": "#/$defs/sha256"}}},
    "features": {"type": "object", "additionalProperties": false, "required": ["xnack", "sramecc", "generic_processor_version"], "properties": {"xnack": {"const": "unsupported"}, "sramecc": {"const": "unsupported"}, "generic_processor_version": {"const": 0}}},
    "codegen": {"type": "object", "additionalProperties": false, "required": ["target", "target_kind", "target_count", "code_object_version", "wavefront_size", "features", "e_flags"], "properties": {"target": {"enum": ["gfx1030", "gfx1201"]}, "target_kind": {"const": "exact"}, "target_count": {"const": 1}, "code_object_version": {"const": "V6"}, "wavefront_size": {"const": 32}, "features": {"$ref": "#/$defs/features"}, "e_flags": {"enum": ["0x00000036", "0x0000004e"]}}},
    "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "row": {"type": "object", "additionalProperties": false, "required": ["row_id", "target", "tier", "required", "seed", "execution", "build", "resource", "output", "codegen"], "properties": {
      "row_id": {"pattern": "^h3-rmsnorm-gfx(?:1030|1201)$", "type": "string"}, "target": {"enum": ["gfx1030", "gfx1201"]}, "tier": {"const": "tier_h3_rmsnorm"}, "required": {"const": false}, "seed": {"type": "integer", "minimum": 1},
      "execution": {"type": "object", "additionalProperties": false, "required": ["mode", "compile_only", "requires_gpu", "requires_model", "network", "fallback_allowed", "execution_attempted", "gpu_execution", "fake_hip", "emulation"], "properties": {"mode": {"const": "compile-link-extract-inspect-only"}, "compile_only": {"const": true}, "requires_gpu": {"const": false}, "requires_model": {"const": false}, "network": {"const": false}, "fallback_allowed": {"const": false}, "execution_attempted": {"const": false}, "gpu_execution": {"const": false}, "fake_hip": {"const": false}, "emulation": {"const": false}}},
      "build": {"type": "object", "additionalProperties": false, "required": ["generator", "mode", "build_type", "language_standard", "sources", "commands"], "properties": {"generator": {"const": "direct-amdclang++"}, "mode": {"const": "compile-link-extract-inspect"}, "build_type": {"const": "Release"}, "language_standard": {"const": "gnu++17"}, "sources": {"const": ["native/hip/src/rmsnorm_kernel.hip.cpp", "native/hip/src/public_runtime.hip.cpp", "native/hip/src/rmsnorm_api.cpp"]}, "commands": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/command"}}}},
      "resource": {"type": "object", "additionalProperties": false, "required": ["max_rss_bytes", "max_output_bytes", "timeout_seconds", "max_output_file_bytes"], "properties": {"max_rss_bytes": {"const": 4294967296}, "max_output_bytes": {"const": 16777216}, "timeout_seconds": {"const": 900}, "max_output_file_bytes": {"const": 268435456}}},
      "output": {"type": "object", "additionalProperties": false, "required": ["root_prefix", "directory_pattern", "host_elf_pattern", "device_object_pattern", "artifact_metadata", "report"], "properties": {"root_prefix": {"const": "/tmp/sllm-rmsnorm-h3-"}, "directory_pattern": {"const": "h3-rmsnorm-{target}"}, "host_elf_pattern": {"const": "host-bundle-{target}.elf"}, "device_object_pattern": {"const": "device-code-object-{target}.elf"}, "artifact_metadata": {"const": "rmsnorm-h3-artifact.json"}, "report": {"const": "rmsnorm-h3-report.json"}}},
      "codegen": {"$ref": "#/$defs/codegen"}
    }}
  },
  "required": ["$schema", "schema_version", "matrix_id", "revision", "suite_id", "tier", "toolchain_id", "container", "workflow", "source_sets", "source_symbol_map", "public_abi_symbols", "logical_kernel", "device_symbol", "case_manifest", "rows"],
  "properties": {
    "$schema": {"const": "https://sllm-project.local/ci/schema/rmsnorm-h3-compile-v1.schema.json"}, "schema_version": {"const": "rmsnorm-h3-compile-v1"}, "matrix_id": {"const": "rmsnorm-h3-compile-v1"}, "revision": {"const": 4}, "suite_id": {"const": "h3-rmsnorm-compile-only"}, "tier": {"const": "tier_h3_rmsnorm"}, "toolchain_id": {"const": "rocm-7.14.0"},
    "container": {"type": "object", "additionalProperties": false, "required": ["image_reference", "image_config_digest", "platform", "rocm_root", "compiler", "llvm_major"], "properties": {"image_reference": {"const": "docker.io/rocm/dev-ubuntu-24.04@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7"}, "image_config_digest": {"const": "sha256:4c91c0d850e38a40fd669dd043ab42e9bad9a2b8a38e3f873c5a4eaced9f28cf"}, "platform": {"const": {"os": "linux", "architecture": "amd64"}}, "rocm_root": {"const": "/opt/rocm"}, "compiler": {"const": "/opt/rocm/bin/amdclang++"}, "llvm_major": {"const": 23}}},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": ".github/workflows/rmsnorm-h3-compile.yml"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_sets": {"type": "object", "additionalProperties": false, "required": ["device", "host_abi", "binding_build", "ci_contract"], "properties": {"device": {"$ref": "#/$defs/source_set"}, "host_abi": {"$ref": "#/$defs/source_set"}, "binding_build": {"$ref": "#/$defs/source_set"}, "ci_contract": {"$ref": "#/$defs/source_set"}}},
    "source_symbol_map": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["path", "symbol", "role"], "properties": {"path": {"$ref": "#/$defs/path"}, "symbol": {"type": "string", "minLength": 1}, "role": {"enum": ["declaration", "definition", "abi-binding", "wrapper", "device-definition"]}}}},
    "public_abi_symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sllm_[A-Za-z0-9_]+$"}}, "logical_kernel": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"},
    "case_manifest": {"type": "object", "additionalProperties": false, "required": ["id", "selected_count", "collected_count", "execution_attempted", "gpu_execution", "model_used", "network_used", "fallback_allowed", "fake_hip", "emulation"], "properties": {"id": {"const": "rmsnorm-h3-compile-link-extract-inspect-v1"}, "selected_count": {"const": 1}, "collected_count": {"const": 1}, "execution_attempted": {"const": false}, "gpu_execution": {"const": false}, "model_used": {"const": false}, "network_used": {"const": false}, "fallback_allowed": {"const": false}, "fake_hip": {"const": false}, "emulation": {"const": false}}},
    "rows": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/row"}}
  }
}
