{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ullm-project.local/ci/schema/test-result-v1.schema.json",
  "title": "uLLM test result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "suite_id", "tier", "state", "required",
    "evidence_mode", "run_id", "run_attempt", "reviewed_sha", "tested_sha",
    "workflow_sha", "git_tree_oid", "worktree_clean",
    "matrix_manifest_sha256", "matrix_row_id", "tuple_digest", "command",
    "command_sha256", "toolchain", "toolchain_sha256", "artifact",
    "created_at", "started_at", "finished_at", "duration_seconds", "seed",
    "counts", "resource", "cases", "steps", "diagnostic"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected", "selected", "passed", "failed", "skipped", "deselected"
      ],
      "properties": {
        "collected": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "deselected": {"type": "integer", "minimum": 0}
      }
    },
    "step_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_limit_seconds", "timed_out", "max_rss_bytes",
        "max_rss_limit_bytes", "rss_breach", "cpu_user_seconds",
        "cpu_system_seconds", "stdout_bytes", "stderr_bytes", "output_bytes",
        "stdout_captured_bytes", "stderr_captured_bytes", "captured_output_bytes",
        "output_limit_bytes", "output_breach", "network_isolated",
        "network_guard_strategy", "address_space_limit_bytes",
        "address_space_limit_enforced"
      ],
      "properties": {
        "wall_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timed_out": {"type": "boolean"},
        "max_rss_bytes": {"type": "integer", "minimum": 0},
        "max_rss_limit_bytes": {"type": "integer", "minimum": 1},
        "rss_breach": {"type": "boolean"},
        "cpu_user_seconds": {"type": "number", "minimum": 0},
        "cpu_system_seconds": {"type": "number", "minimum": 0},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "stdout_captured_bytes": {"type": "integer", "minimum": 0},
        "stderr_captured_bytes": {"type": "integer", "minimum": 0},
        "captured_output_bytes": {"type": "integer", "minimum": 0},
        "output_limit_bytes": {"type": "integer", "minimum": 1},
        "output_breach": {"type": "boolean"},
        "network_isolated": {"type": "boolean"},
        "network_guard_strategy": {"type": "string", "minLength": 1},
        "address_space_limit_bytes": {"type": ["integer", "null"], "minimum": 1},
        "address_space_limit_enforced": {"type": "boolean"}
      }
    },
    "row_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_limit_seconds", "wall_time_breach", "max_rss_bytes",
        "max_rss_limit_bytes", "rss_breach", "runner_max_rss_bytes",
        "fixture_size_bytes", "fixture_size_limit_bytes", "fixture_size_breach",
        "output_bytes", "captured_output_bytes", "row_output_limit_bytes", "output_breach",
        "address_space_limit_bytes", "commands_expected", "commands_executed",
        "commands_complete", "network_isolated", "network_guard_strategies"
      ],
      "properties": {
        "wall_time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "wall_time_breach": {"type": "boolean"},
        "max_rss_bytes": {"type": "integer", "minimum": 0},
        "max_rss_limit_bytes": {"type": "integer", "minimum": 1},
        "rss_breach": {"type": "boolean"},
        "runner_max_rss_bytes": {"type": "integer", "minimum": 0},
        "fixture_size_bytes": {"type": "integer", "minimum": 0},
        "fixture_size_limit_bytes": {"type": "integer", "minimum": 1},
        "fixture_size_breach": {"type": "boolean"},
        "output_bytes": {"type": "integer", "minimum": 0},
        "captured_output_bytes": {"type": "integer", "minimum": 0},
        "row_output_limit_bytes": {"type": "integer", "minimum": 1},
        "output_breach": {"type": "boolean"},
        "address_space_limit_bytes": {"type": ["integer", "null"], "minimum": 1},
        "commands_expected": {"type": "integer", "minimum": 1},
        "commands_executed": {"type": "integer", "minimum": 0},
        "commands_complete": {"type": "boolean"},
        "network_isolated": {"type": "boolean"},
        "network_guard_strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "started_at", "finished_at", "duration_seconds", "exit_code",
        "stdout_sha256", "stderr_sha256", "diagnostic", "selection_required",
        "count_source", "counts", "resource"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
        },
        "state": {"enum": ["PASS", "FAIL", "SKIP", "INFRA_ERROR"]},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "diagnostic": {"type": "string"},
        "selection_required": {"type": "boolean"},
        "count_source": {
          "enum": [
            "validator-command", "pytest-machine", "cargo-harness",
            "unittest-machine"
          ]
        },
        "counts": {"$ref": "#/$defs/counts"},
        "resource": {"$ref": "#/$defs/step_resource"}
      }
    },
    "h3_toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain_id", "manifest_sha256", "rocm", "compiler", "paths", "observed"],
      "properties": {
        "toolchain_id": {"const": "rocm-7.14.0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "rocm": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "version", "llvm_major"],
          "properties": {"path": {"const": "/opt/rocm"}, "version": {"const": "7.14.0"}, "llvm_major": {"const": 23}}
        },
        "compiler": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "path", "version", "llvm_major"],
          "properties": {"name": {"const": "amdclang++"}, "path": {"const": "/opt/rocm/bin/amdclang++"}, "version": {"type": "string", "pattern": "^23\\."}, "llvm_major": {"const": 23}}
        },
        "paths": {
          "type": "object", "additionalProperties": false,
          "required": ["rocm_root", "compiler", "hip_headers", "hip_cmake_package", "device_libraries", "hip_runtime", "clang_offload_bundler", "llvm_objcopy", "llvm_readobj", "llvm_objdump"],
          "properties": {
            "rocm_root": {"const": "/opt/rocm"}, "compiler": {"const": "/opt/rocm/bin/amdclang++"}, "hip_headers": {"const": "/opt/rocm/include"},
            "hip_cmake_package": {"const": "/opt/rocm/lib/cmake/hip"}, "device_libraries": {"const": "/opt/rocm/amdgcn/bitcode"},
            "hip_runtime": {"const": "/opt/rocm/lib/libamdhip64.so"}, "clang_offload_bundler": {"const": "/opt/rocm/lib/llvm/bin/clang-offload-bundler"}, "llvm_objcopy": {"const": "/opt/rocm/lib/llvm/bin/llvm-objcopy"},
            "llvm_readobj": {"const": "/opt/rocm/lib/llvm/bin/llvm-readobj"}, "llvm_objdump": {"const": "/opt/rocm/lib/llvm/bin/llvm-objdump"}
          }
        },
        "observed": {
          "type": "object", "additionalProperties": false,
          "required": ["compiler_version", "llvm_major", "tools"],
          "properties": {
            "compiler_version": {"type": "string", "minLength": 1}, "llvm_major": {"const": 23},
            "tools": {
              "type": "object", "additionalProperties": false,
              "required": ["clang_offload_bundler", "llvm_objcopy", "llvm_readobj", "llvm_objdump"],
              "properties": {"clang_offload_bundler": {"type": "string", "minLength": 1}, "llvm_objcopy": {"type": "string", "minLength": 1}, "llvm_readobj": {"type": "string", "minLength": 1}, "llvm_objdump": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "h3_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "size_bytes", "content_sha256", "metadata_sha256", "metadata_sidecar_sha256", "artifact_sidecar_sha256"],
      "properties": {
        "target": {"enum": ["gfx1030", "gfx1201"]}, "size_bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/sha256"}, "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sidecar_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h3_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["compile_only", "link_verified", "gpu_execution", "execution_attempted", "numerics_verified", "model_verified", "performance_verified", "support_claim", "network_used", "model_used", "cpu_fallback_used"],
      "properties": {
        "compile_only": {"const": true}, "link_verified": {"type": "boolean"}, "gpu_execution": {"const": false}, "execution_attempted": {"const": false},
        "numerics_verified": {"const": false}, "model_verified": {"const": false}, "performance_verified": {"const": false}, "support_claim": {"const": false},
        "network_used": {"const": false}, "model_used": {"const": false}, "cpu_fallback_used": {"const": false}
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "execution_scope", "container_image_reference",
        "observed_image_config_digest", "pinned_container", "identity_verified",
        "network_isolated"
      ],
      "properties": {
        "mode": {"enum": ["required-ci", "local-development"]},
        "execution_scope": {"enum": ["official-container", "local-system"]},
        "container_image_reference": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9./_-]+@sha256:[0-9a-f]{64}$"
        },
        "observed_image_config_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pinned_container": {"type": "boolean"},
        "identity_verified": {"type": "boolean"},
        "network_isolated": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "test-result-v1"},
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "tier": {
      "enum": [
        "tier_h0", "tier_h1", "tier_h2", "tier_h3", "tier_g0", "tier_g1",
        "tier_g2", "tier_g3", "tier_g4", "tier_p0", "tier_p1"
      ]
    },
    "state": {"enum": ["PASS", "FAIL", "SKIP", "INFRA_ERROR", "QUARANTINED"]},
    "required": {"type": "boolean"},
    "evidence_mode": {"enum": ["required-ci", "local-development"]},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "run_attempt": {"type": "integer", "minimum": 1},
    "reviewed_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_tree_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_clean": {"type": "boolean"},
    "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_row_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "tuple_digest": {"$ref": "#/$defs/sha256"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python", "platform", "system", "machine", "git", "rustc_dev",
        "cargo_dev", "rustc_msrv", "cargo_msrv", "clang_format", "cmake",
        "host_packages"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "rustc_dev": {"type": "string", "minLength": 1},
        "cargo_dev": {"type": "string", "minLength": 1},
        "rustc_msrv": {"type": "string", "minLength": 1},
        "cargo_msrv": {"type": "string", "minLength": 1},
        "clang_format": {"type": "string", "minLength": 1},
        "cmake": {"type": "string", "minLength": 1},
        "host_packages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "h3": {"$ref": "#/$defs/h3_toolchain"}
      }
    },
    "toolchain_sha256": {"$ref": "#/$defs/sha256"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "manifest_sha256"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h3_artifact": {"$ref": "#/$defs/h3_artifact"},
    "h3_scope": {"$ref": "#/$defs/h3_scope"},
    "execution_environment": {"$ref": "#/$defs/execution_environment"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "counts": {"$ref": "#/$defs/counts"},
    "resource": {"$ref": "#/$defs/row_resource"},
    "cases": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/execution_record"},
          {"required": ["case_id"], "not": {"required": ["step_id"]}}
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/execution_record"},
          {"required": ["step_id"], "not": {"required": ["case_id"]}}
        ]
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message", "errors", "warnings", "network_disabled",
        "model_disabled", "gpu_fallback_disabled", "network_guard_self_test"
      ],
      "properties": {
        "message": {"type": "string"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "output_dir": {"type": "string"},
        "network_disabled": {"type": "boolean"},
        "model_disabled": {"const": true},
        "gpu_fallback_disabled": {"const": true},
        "network_guard_self_test": {"type": "boolean"}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid", "bdf", "exact_target", "selected_backend", "dispatch_count",
        "fallback_allowed", "fallback_used", "code_object"
      ],
      "properties": {
        "uuid": {"type": "string"},
        "bdf": {"type": "string"},
        "exact_target": {"type": "string"},
        "selected_backend": {"type": "string"},
        "dispatch_count": {"type": "integer", "minimum": 0},
        "dispatch_ids": {"type": "array", "items": {"type": "string"}},
        "fallback_allowed": {"type": "boolean"},
        "fallback_used": {"type": "boolean"},
        "code_object": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"required": {"const": true}}},
      "then": {
        "properties": {
          "state": {"not": {"enum": ["SKIP", "QUARANTINED"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_mode": {"const": "required-ci"},
          "state": {"const": "PASS"}
        }
      },
      "then": {"properties": {"worktree_clean": {"const": true}}}
    },
    {
      "if": {"properties": {"matrix_row_id": {"const": "h2"}}},
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "address_space_limit_bytes": {"const": 4294967296}
            }
          },
          "steps": {
            "items": {
              "properties": {
                "resource": {
                  "properties": {
                    "address_space_limit_bytes": {"const": 4294967296}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "enum": [
              "tier_g0", "tier_g1", "tier_g2", "tier_g3", "tier_g4",
              "tier_p0", "tier_p1"
            ]
          }
      }
      },
      "then": {"required": ["gpu"]}
    },
    {
      "if": {"properties": {"tier": {"const": "tier_h3"}}},
      "then": {
        "required": ["h3_artifact", "h3_scope", "execution_environment"],
        "properties": {
          "required": {"const": false},
          "toolchain": {"required": ["h3"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {"const": "tier_h3"},
          "state": {"const": "PASS"},
          "evidence_mode": {"const": "required-ci"}
        }
      },
      "then": {
        "properties": {
          "h3_scope": {"properties": {"link_verified": {"const": true}}},
          "execution_environment": {
            "properties": {
              "mode": {"const": "required-ci"},
              "execution_scope": {"const": "official-container"},
              "pinned_container": {"const": true},
              "identity_verified": {"const": true},
              "network_isolated": {"const": true},
              "container_image_reference": {"const": "docker.io/rocm/dev-ubuntu-24.04@sha256:439edaa8f0c4be4a3728e528f87b8a2ea1f051f34cf10b27caa4bd94f562eda7"},
              "observed_image_config_digest": {"const": "sha256:4c91c0d850e38a40fd669dd043ab42e9bad9a2b8a38e3f873c5a4eaced9f28cf"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {"const": "tier_h3"},
          "state": {"const": "PASS"},
          "evidence_mode": {"const": "local-development"}
        }
      },
      "then": {
        "properties": {
          "execution_environment": {
            "properties": {
              "execution_scope": {"const": "local-system"},
              "container_image_reference": {"const": null},
              "observed_image_config_digest": {"const": null},
              "pinned_container": {"const": false},
              "identity_verified": {"const": false},
              "network_isolated": {"const": false}
            }
          },
          "diagnostic": {
            "properties": {
              "network_disabled": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {"enum": ["tier_h0", "tier_h1", "tier_h2"]}
        }
      },
      "then": {
        "properties": {
          "diagnostic": {
            "properties": {
              "network_disabled": {"const": true}
            }
          }
        }
      }
    }
  ]
}
