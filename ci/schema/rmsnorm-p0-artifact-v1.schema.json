{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/rmsnorm-p0-artifact-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "row_id", "target", "candidate", "binary", "build", "source_set", "execution_contract", "scope", "prerequisites"],
  "properties": {
    "schema_version": {"const": "rmsnorm-p0-artifact-v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "row_id": {"enum": ["rmsnorm-p0-gfx1030", "rmsnorm-p0-gfx1201"]},
    "target": {"enum": ["gfx1030", "gfx1201"]},
    "candidate": {"$ref": "#/$defs/candidate"},
    "binary": {"$ref": "#/$defs/binary"},
    "build": {"$ref": "#/$defs/build"},
    "source_set": {"$ref": "#/$defs/source_set"},
    "execution_contract": {"$ref": "#/$defs/execution_contract"},
    "scope": {"$ref": "#/$defs/scope"},
    "prerequisites": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/prerequisite"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"], "properties": {"reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"}, "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sidecar_path", "size_bytes", "sha256", "sidecar_sha256"], "properties": {"role": {"const": "dedicated-p0-public-rmsnorm-producer"}, "path": {"const": "sllm-rmsnorm-p0-evidence"}, "sidecar_path": {"const": "sllm-rmsnorm-p0-evidence.sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"}}},
    "build": {"type": "object", "additionalProperties": false, "required": ["builder", "command", "profile", "binary_name", "output_path", "fresh_output", "substitution_rejected", "environment", "limits"], "properties": {"builder": {"const": "ci/tools/build_rmsnorm_p0_runtime.py"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "profile": {"const": "release"}, "binary_name": {"const": "sllm-rmsnorm-p0-evidence"}, "output_path": {"const": "sllm-rmsnorm-p0-evidence"}, "fresh_output": {"const": true}, "substitution_rejected": {"const": true}, "environment": {"type":"object","additionalProperties":false,"required":["ROCM_PATH","HIP_PATH","SLLM_HIP_COMPILER","CMAKE_HIP_ARCHITECTURES","SLLM_HIP_CODEGEN_FEATURES","SLLM_ENABLE_HIP_RUNTIME","SLLM_ENABLE_PUBLIC_HIP_RUNTIME","SLLM_ENABLE_HIP_COMPILE_PROBE"],"properties":{"ROCM_PATH":{"const":"/opt/rocm"},"HIP_PATH":{"const":"/opt/rocm"},"SLLM_HIP_COMPILER":{"const":"/opt/rocm/bin/amdclang++"},"CMAKE_HIP_ARCHITECTURES":{"enum":["gfx1030","gfx1201"]},"SLLM_HIP_CODEGEN_FEATURES":{"const":"co_v6,wave32,xnack=unsupported,sramecc=unsupported,generic_processor_version=0"},"SLLM_ENABLE_HIP_RUNTIME":{"const":"0"},"SLLM_ENABLE_PUBLIC_HIP_RUNTIME":{"const":"1"},"SLLM_ENABLE_HIP_COMPILE_PROBE":{"const":"0"}}}, "limits": {"type":"object","additionalProperties":false,"required":["timeout_seconds","combined_output_bytes","start_new_session","process_group_cleanup","termination_grace_seconds"],"properties":{"timeout_seconds":{"const":900},"combined_output_bytes":{"const":4194304},"start_new_session":{"const":true},"process_group_cleanup":{"const":"term-kill-group-disappearance-v1"},"termination_grace_seconds":{"const":2}}}}},
    "source_file": {"type": "object", "additionalProperties": false, "required": ["order", "path", "sha256"], "properties": {"order": {"type": "integer", "minimum": 0, "maximum": 83}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_set": {"type": "object", "additionalProperties": false, "required": ["identity", "files", "sha256"], "properties": {"identity": {"const": "rmsnorm-p0-enabled-public-path-source-set-v1"}, "files": {"type": "array", "minItems": 84, "maxItems": 84, "items": {"$ref": "#/$defs/source_file"}}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "dtype": {"type": "object", "additionalProperties": false, "required": ["activation", "weight", "output", "accumulation", "scale_mode", "epsilon"], "properties": {"activation": {"const": "BF16"}, "weight": {"const": "BF16"}, "output": {"const": "BF16"}, "accumulation": {"const": "F32"}, "scale_mode": {"const": "offset-one"}, "epsilon": {"const": "1e-6"}}},
    "execution_contract": {"type": "object", "additionalProperties": false, "required": ["public_path", "kernel_id", "kernel_symbol", "device_symbol", "workgroup_size_x", "timing_contract", "dtype", "producer_status"], "properties": {"public_path": {"const": "SemanticOpDescriptor->Backend->sllm-hip->public-C-ABI->native-HIP-registry->rmsnorm.baseline.wave32.v1"}, "kernel_id": {"const": 1}, "kernel_symbol": {"const": "rmsnorm.baseline.wave32.v1"}, "device_symbol": {"const": "sllm_rmsnorm_baseline_wave32_v1"}, "workgroup_size_x": {"const": 256}, "timing_contract": {"const": "rmsnorm-p0-timing-v1"}, "dtype": {"$ref": "#/$defs/dtype"}, "producer_status": {"const": "a5-enabled"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["selected_backend", "public_rmsnorm_path", "semantic_op_used", "model_used", "hip_only", "fallback_allowed", "fallback_used", "cpu_fallback_used"], "properties": {"selected_backend": {"const": "hip"}, "public_rmsnorm_path": {"const": true}, "semantic_op_used": {"const": true}, "model_used": {"const": false}, "hip_only": {"const": true}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false}, "cpu_fallback_used": {"const": false}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["kind", "row_id", "state", "candidate_sha256", "artifact_sha256", "report_sha256"], "properties": {"kind": {"enum": ["g0", "private_g1", "semantic_g1", "g2", "h3"]}, "row_id": {"type": "string", "minLength": 1}, "state": {"const": "bound-not-executed-by-p0"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "report_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
