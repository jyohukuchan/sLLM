      "properties": {
        "temperature_c": {"type": "object", "additionalProperties": false, "required": ["edge", "hotspot", "mem"], "properties": {"edge": {"type": "number"}, "hotspot": {"type": "number"}, "mem": {"type": "number"}}},
        "gfx_clock_mhz": {"type": "number", "minimum": 0},
        "mem_clock_mhz": {"type": "number", "minimum": 0},
