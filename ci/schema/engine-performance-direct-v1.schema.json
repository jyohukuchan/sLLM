{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/engine-performance-direct-v1.schema.json",
  "title": "sLLM direct engine performance CLI result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_schema_version",
    "state",
    "lane",
    "lane_definition",
    "row",
    "identities",
    "model_load",
    "config",
    "memory",
    "audit",
    "cleanup",
    "session_cleanup",
    "correctness_control",
    "warmups",
    "measured"
  ],
  "properties": {
    "benchmark_schema_version": {
      "const": "engine-performance-direct-v1"
    },
    "state": {
      "const": "PASS"
    },
    "lane": {
      "const": "direct"
    },
    "lane_definition": {
      "const": "pretokenized direct engine: request start excludes render/tokenize"
    },
    "row": {
      "$ref": "#/$defs/row"
    },
    "identities": {
      "$ref": "#/$defs/identities"
    },
    "model_load": {
      "$ref": "#/$defs/model_load"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "memory": {
      "$ref": "#/$defs/memory"
    },
    "correctness_control": {
      "$ref": "#/$defs/correctness_control"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "session_cleanup": {
      "$ref": "#/$defs/session_cleanup"
    },
    "warmups": {
      "$ref": "#/$defs/warmups"
    },
    "measured": {
      "$ref": "#/$defs/measured"
    }
  },
  "$defs": {
    "token_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 248319
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "model_size",
        "case_id",
        "input_token_ids",
        "input_token_count",
        "requested_output_tokens"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^engine-performance-direct-(2b|4b|9b)-gfx(1030|1201)-[a-z0-9-]+$"
        },
        "model_size": {
          "enum": [
            "2B",
            "4B",
            "9B"
          ]
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "input_token_ids": {
          "$ref": "#/$defs/token_ids"
        },
        "input_token_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "requested_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_size",
        "repo_id",
        "resolved_revision",
        "lock_fingerprint"
      ],
      "properties": {
        "model_size": {
          "enum": [
            "2B",
            "4B",
            "9B"
          ]
        },
        "repo_id": {
          "enum": [
            "Qwen/Qwen3.5-2B",
            "Qwen/Qwen3.5-4B",
            "Qwen/Qwen3.5-9B"
          ]
        },
        "resolved_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lock_fingerprint": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "backend",
        "session_id",
        "device_index",
        "target",
        "model",
        "binding"
      ],
      "properties": {
        "engine": {
          "const": "sllm"
        },
        "backend": {
          "const": "hip"
        },
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "device_index": {
          "const": 0
        },
        "target": {
          "enum": [
            "gfx1030",
            "gfx1201"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_fingerprint",
            "plan_digest"
          ],
          "properties": {
            "model_fingerprint": {
              "$ref": "#/$defs/digest"
            },
            "plan_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "model_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "start_ns",
        "model_ready_ns",
        "duration_ns",
        "load_count"
      ],
      "properties": {
        "event": {
          "const": "model_load"
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "model_ready_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "load_count": {
          "const": 1
        }
      }
    },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_token_ids",
        "visible_stop_tokens"
      ],
      "properties": {
        "stop_token_ids": {
          "const": [
            248046,
            248044
          ]
        },
        "visible_stop_tokens": {
          "const": false
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_token_ids",
        "input_token_count",
        "max_new_tokens",
        "greedy",
        "warmups",
        "measured",
        "tokenizer",
        "render",
        "stop_policy"
      ],
      "properties": {
        "input_token_ids": {
          "$ref": "#/$defs/token_ids"
        },
        "input_token_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "greedy": {
          "const": true
        },
        "warmups": {
          "const": 3
        },
        "measured": {
          "const": 10
        },
        "tokenizer": {
          "const": false
        },
        "render": {
          "const": false
        },
        "stop_policy": {
          "$ref": "#/$defs/stop_policy"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_resident",
        "request_state",
        "workspace",
        "current_bytes",
        "high_water_bytes",
        "poisoned"
      ],
      "properties": {
        "model_resident": {
          "$ref": "#/$defs/category"
        },
        "request_state": {
          "$ref": "#/$defs/category"
        },
        "workspace": {
          "$ref": "#/$defs/category"
        },
        "current_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "high_water_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "poisoned": {
          "const": false
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_bytes",
        "high_water_bytes"
      ],
      "properties": {
        "current_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "high_water_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ready",
        "after_model_drop",
        "model_resident_high_water_bytes",
        "resident_vram_bytes",
        "resident_vram_source",
        "peak_vram_bytes",
        "peak_source"
      ],
      "properties": {
        "model_ready": {
          "$ref": "#/$defs/snapshot"
        },
        "after_model_drop": {
          "$ref": "#/$defs/snapshot"
        },
        "model_resident_high_water_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "resident_vram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "resident_vram_source": {
          "const": "model_resident_allocator_high_water"
        },
        "peak_vram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "peak_source": {
          "const": "runtime_allocator"
        }
      }
    },
    "sample_events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_start_ns",
        "prefill_submit_ns",
        "prefill_complete_ns",
        "first_token_ns",
        "later_token_publications_ns",
        "stop_ns",
        "cleanup_ns"
      ],
      "properties": {
        "request_start_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "prefill_submit_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "prefill_complete_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "first_token_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "later_token_publications_ns": {
          "type": "array",
          "maxItems": 4095,
          "items": {
            "type": "integer",
            "minimum": 0,
          "maximum": 9223372036854775807
          }
        },
        "stop_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cleanup_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "sample_derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttft_ns",
        "prefill_ns",
        "prefill_tokens_per_second",
        "e2e_ns",
        "tpot_ns",
        "decode_tokens",
        "decode_tokens_per_second"
      ],
      "properties": {
        "ttft_ns": {
          "type": "integer",
          "minimum": 1
        },
        "prefill_ns": {
          "type": "integer",
          "minimum": 1
        },
        "prefill_tokens_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "e2e_ns": {
          "type": "integer",
          "minimum": 1
        },
        "tpot_ns": {
          "type": "array",
          "maxItems": 4095,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "decode_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "decode_tokens_per_second": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "sample_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_token_ids",
        "generated_token_ids",
        "visible_token_ids",
        "decode_input_token_ids"
      ],
      "properties": {
        "input_token_ids": {
          "$ref": "#/$defs/token_ids"
        },
        "generated_token_ids": {
          "$ref": "#/$defs/token_ids"
        },
        "visible_token_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 248319
          }
        },
        "decode_input_token_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 248319
          }
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "reason_version",
        "kind",
        "token_id"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "reason_version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "max_new_tokens",
            "stop_token"
          ]
        },
        "token_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                248046,
                248044
              ]
            }
          ]
        }
      }
    },
    "sample_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_backend",
        "target",
        "device_index",
        "model_fingerprint",
        "plan_digest",
        "fallback_used",
        "submission_count",
        "kernel_dispatch_count",
        "segment_count",
        "boundary_count",
        "all_dispatches_hip"
      ],
      "properties": {
        "selected_backend": {
          "const": "hip"
        },
        "target": {
          "enum": [
            "gfx1030",
            "gfx1201"
          ]
        },
        "device_index": {
          "const": 0
        },
        "model_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "fallback_used": {
          "const": false
        },
        "submission_count": {
          "type": "integer",
          "minimum": 1
        },
        "kernel_dispatch_count": {
          "type": "integer",
          "minimum": 1
        },
        "segment_count": {
          "type": "integer",
          "minimum": 1
        },
        "boundary_count": {
          "type": "integer",
          "minimum": 1
        },
        "all_dispatches_hip": {
          "const": true
        }
      }
    },
    "sample_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_start",
        "after_cleanup"
      ],
      "properties": {
        "request_start": {
          "$ref": "#/$defs/snapshot"
        },
        "after_cleanup": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "sample_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_index",
        "request_dropped",
        "allocator_cleanup_validated",
        "retryable_cleanup",
        "durable_quarantine"
      ],
      "properties": {
        "sample_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "request_dropped": {
          "const": true
        },
        "allocator_cleanup_validated": {
          "const": true
        },
        "retryable_cleanup": {
          "const": 0
        },
        "durable_quarantine": {
          "const": 0
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_path",
        "timing_instrumentation",
        "events",
        "derived",
        "tokens",
        "stop",
        "audit",
        "memory",
        "cleanup"
      ],
      "properties": {
        "execution_path": {
          "const": "timed-production"
        },
        "timing_instrumentation": {
          "const": "on"
        },
        "events": {
          "$ref": "#/$defs/sample_events"
        },
        "derived": {
          "$ref": "#/$defs/sample_derived"
        },
        "tokens": {
          "$ref": "#/$defs/sample_tokens"
        },
        "stop": {
          "$ref": "#/$defs/stop"
        },
        "audit": {
          "$ref": "#/$defs/sample_audit"
        },
        "memory": {
          "$ref": "#/$defs/sample_memory"
        },
        "cleanup": {
          "$ref": "#/$defs/sample_cleanup"
        }
      }
    },
    "correctness_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "execution_path",
        "timing_instrumentation",
        "included_in_performance_statistics",
        "tokens",
        "stop",
        "audit",
        "memory",
        "cleanup",
        "comparison"
      ],
      "properties": {
        "label": {"const": "correctness-only"},
        "execution_path": {"const": "normal-untimed"},
        "timing_instrumentation": {"const": "off"},
        "included_in_performance_statistics": {"const": false},
        "tokens": {"$ref": "#/$defs/sample_tokens"},
        "stop": {"$ref": "#/$defs/stop"},
        "audit": {"$ref": "#/$defs/sample_audit"},
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_start", "after_cleanup"],
          "properties": {
            "request_start": {"$ref": "#/$defs/snapshot"},
            "after_cleanup": {"$ref": "#/$defs/snapshot"}
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_dropped", "allocator_cleanup_validated"],
          "properties": {
            "request_dropped": {"const": true},
            "allocator_cleanup_validated": {"const": true}
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scope", "token_fields", "stop_fields", "dispatch_fields", "dispatch_count_rule"],
          "properties": {
            "mode": {"const": "exact"},
            "scope": {"const": "every_warmup_and_measured_sample"},
            "token_fields": {"const": ["input_token_ids", "generated_token_ids", "visible_token_ids", "decode_input_token_ids"]},
            "stop_fields": {"const": ["version", "reason_version", "kind", "token_id"]},
            "dispatch_fields": {"const": ["selected_backend", "target", "device_index", "model_fingerprint", "plan_digest", "fallback_used", "all_dispatches_hip", "submission_count", "kernel_dispatch_count", "segment_count", "boundary_count"]},
            "dispatch_count_rule": {"const": "exact_when_token_and_stop_fields_match"}
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_backend",
        "target",
        "device_index",
        "submission_count",
        "kernel_dispatch_count",
        "segment_count",
        "boundary_count",
        "fallback_used",
        "all_dispatches_hip",
        "model_load_count",
        "weight_encoding",
        "fp8_provider",
        "request_model_load_count",
        "model_reused",
        "sample_count",
        "correctness_control_request_count",
        "total_request_count"
      ],
      "properties": {
        "selected_backend": {
          "const": "hip"
        },
        "target": {
          "enum": [
            "gfx1030",
            "gfx1201"
          ]
        },
        "device_index": {
          "const": 0
        },
        "submission_count": {
          "type": "integer",
          "minimum": 1
        },
        "kernel_dispatch_count": {
          "type": "integer",
          "minimum": 1
        },
        "segment_count": {
          "type": "integer",
          "minimum": 1
        },
        "boundary_count": {
          "type": "integer",
          "minimum": 1
        },
        "fallback_used": {
          "const": false
        },
        "all_dispatches_hip": {
          "const": true
        },
        "model_load_count": {
          "const": 1
        },
        "weight_encoding": {
          "enum": [
            "bf16",
            "bf16-converted-from-ocp-e4m3fn",
            "e4m3fnuz-converted-from-ocp-e4m3fn-outer-f32",
            "ocp-e4m3fn-outer-f32"
          ]
        },
        "fp8_provider": {
          "type": ["string", "null"],
          "enum": [null, "native", "native-fnuz", "emulation", "converted-bf16"]
        },
        "request_model_load_count": {
          "const": 0
        },
        "model_reused": {
          "const": true
        },
        "sample_count": {
          "const": 13
        },
        "correctness_control_request_count": {
          "const": 1
        },
        "total_request_count": {
          "const": 14
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness_control_request_count",
        "warmup_request_count",
        "measured_request_count",
        "request_cleanup_count",
        "performance_sample_count",
        "all_requests_dropped",
        "correctness_control_dropped",
        "retryable_cleanup",
        "durable_quarantine"
      ],
      "properties": {
        "correctness_control_request_count": {
          "const": 1
        },
        "warmup_request_count": {
          "const": 3
        },
        "measured_request_count": {
          "const": 10
        },
        "request_cleanup_count": {
          "const": 14
        },
        "performance_sample_count": {
          "const": 13
        },
        "all_requests_dropped": {
          "const": true
        },
        "correctness_control_dropped": {
          "const": true
        },
        "retryable_cleanup": {
          "const": 0
        },
        "durable_quarantine": {
          "const": 0
        }
      }
    },
    "session_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryable_cleanup",
        "durable_quarantine"
      ],
      "properties": {
        "retryable_cleanup": {
          "const": 0
        },
        "durable_quarantine": {
          "const": 0
        }
      }
    },
    "warmups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "samples"
      ],
      "properties": {
        "count": {
          "const": 3
        },
        "samples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "samples"
      ],
      "properties": {
        "count": {
          "const": 10
        },
        "samples": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "manifest_device": {
      "type": "object",
      "additionalProperties": false,
