    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cadence_seconds", "tool", "definitions", "visibility", "pre", "during", "post", "checks"],
      "properties": {
        "version": {"const": "engine-performance-evidence-v1"},
        "cadence_seconds": {"const": 1},
        "tool": {"type": "object", "additionalProperties": false, "required": ["path", "tool_version", "library_version", "rocm_version"], "properties": {"path": {"$ref": "#/$defs/path"}, "tool_version": {"type": "string", "minLength": 1}, "library_version": {"type": "string", "minLength": 1}, "rocm_version": {"const": "7.14.0"}}},
        "definitions": {"type": "object", "additionalProperties": false, "required": ["clock_variation", "violation", "process_ownership"], "properties": {"clock_variation": {"const": "Dynamic clock min/max is observational; no numeric threshold is a violation."}, "violation": {"enum": ["When violation accumulators are unavailable, aggregate THROTTLED status is observational; ECC, published thermal/power limits, and exposed active violations remain fail-closed.", "A non-UNTHROTTLED power status or exposed active violation is explicit evidence; all-N/A accumulators are a documented AMD-SMI limitation."]}, "process_ownership": {"const": "Every during sample must name only descendants of the benchmark process group."}}},
        "visibility": {"type": "object", "additionalProperties": false, "required": ["cleared", "selector", "uuid"], "properties": {"cleared": {"const": ["HIP_VISIBLE_DEVICES", "ROCR_VISIBLE_DEVICES", "CUDA_VISIBLE_DEVICES", "GPU_DEVICE_ORDINAL"]}, "selector": {"const": "ROCR_VISIBLE_DEVICES"}, "uuid": {"type": "string", "pattern": "^GPU-[0-9a-f]{16}$"}}},
        "pre": {"$ref": "#/$defs/evidence_phase"},
        "during": {"type": "object", "additionalProperties": false, "required": ["sample_count", "sample_digest", "first", "last", "summary", "process_sample_digest", "loader", "loaders", "violation"], "properties": {"sample_count": {"type": "integer", "minimum": 1}, "sample_digest": {"$ref": "#/$defs/digest"}, "first": {"$ref": "#/$defs/evidence_monitor_sample"}, "last": {"$ref": "#/$defs/evidence_monitor_sample"}, "summary": {"$ref": "#/$defs/evidence_summary"}, "process_sample_digest": {"$ref": "#/$defs/digest"}, "loader": {"$ref": "#/$defs/evidence_loader"}, "loaders": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_loader"}}, "violation": {"$ref": "#/$defs/evidence_violation"}}},
        "post": {"$ref": "#/$defs/evidence_phase"},
        "checks": {"type": "object", "additionalProperties": false, "required": ["exact_identity", "static_identity_unchanged", "profile_unchanged", "limits_unchanged", "performance_level_unchanged", "explicit_violation", "vram_auxiliary_complete", "process_ownership", "loader_paths_verified", "monitor_errors", "process_group_cleanup"], "properties": {"exact_identity": {"type": "boolean"}, "static_identity_unchanged": {"type": "boolean"}, "profile_unchanged": {"type": "boolean"}, "limits_unchanged": {"type": "boolean"}, "performance_level_unchanged": {"type": "boolean"}, "explicit_violation": {"type": "boolean"}, "vram_auxiliary_complete": {"type": "boolean"}, "process_ownership": {"type": "boolean"}, "loader_paths_verified": {"type": "boolean"}, "monitor_errors": {"type": "integer", "minimum": 0}, "process_group_cleanup": {"type": "boolean"}}}
      }
    },
