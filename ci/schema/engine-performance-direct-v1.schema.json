        "row_id": {"type": "string", "pattern": "^engine-performance-direct-(2b|4b|9b)-gfx(1030|1201)-[a-z0-9-]+$"},
        "claims": {"type": "object", "additionalProperties": false, "required": ["baseline_only", "optimized", "faster", "hard_gate"], "properties": {"baseline_only": {"const": true}, "optimized": {"const": false}, "faster": {"const": false}, "hard_gate": {"const": false}}},
        "matrix": {"type": "object", "additionalProperties": false, "required": ["path", "matrix_id", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "matrix_id": {"const": "engine-performance-direct-v1"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "binary": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}},
        "build_identity": {"$ref": "#/$defs/build_identity"},
        "model_lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "fingerprint"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "fingerprint": {"$ref": "#/$defs/digest"}}},
        "model_cache": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "raw_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}},
        "observations": {"type": "object", "additionalProperties": false, "required": ["pre", "post"], "properties": {"pre": {"$ref": "#/$defs/observation"}, "post": {"$ref": "#/$defs/observation"}}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "execution": {"$ref": "#/$defs/manifest_execution"}, "cleanup": {"$ref": "#/$defs/manifest_cleanup"}
      }
    }
  }
