{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.dev/schema/phase46-tool-run-v1.schema.json",
  "title": "sLLM Phase 46 common tool run manifest v1",
  "description": "Identity and bounded result envelope shared by artifact, benchmark, quality, and debug tools. New required fields require a schema version; additive data belongs in extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_size", "canonicalization", "operation", "state", "selected_count", "tool", "recipe", "sources", "outputs", "raw_evidence", "identities", "metrics", "extensions"],
  "properties": {
    "schema_version": {"const": "sllm-phase46-tool-run-v1"},
    "struct_size": {"const": 13},
    "canonicalization": {"const": "sllm-sorted-json-v1"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["PASS", "FAIL", "INSUFFICIENT-EVIDENCE"]},
    "selected_count": {"type": "integer", "minimum": 1},
    "tool": {"$ref": "#/$defs/tool"},
    "recipe": {"$ref": "#/$defs/recipe"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/file"}},
    "raw_evidence": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/file"}},
    "identities": {"$ref": "#/$defs/string_map"},
    "metrics": {"type": "object", "propertyNames": {"minLength": 1, "maxLength": 256}, "additionalProperties": true},
    "extensions": {"type": "object", "propertyNames": {"minLength": 1, "maxLength": 256}, "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "logical_name", "size_bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1, "maxLength": 256},
        "logical_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "package", "version", "executable_sha256", "arguments", "environment"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/digest"},
        "arguments": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 16384}},
        "environment": {"$ref": "#/$defs/string_map"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "config_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "config_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "string_map": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
