{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm-project.local/ci/schema/g1-report-v1.schema.json",
  "title": "sLLM model-free G1 evidence report v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "state": {"const": "PASS"},
    "observation": {"type": "object", "additionalProperties": true},
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["bdf", "uuid", "target"],
      "properties": {
        "bdf": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"},
        "uuid": {"type": "string", "pattern": "^GPU-[0-9a-f]{16}$"},
        "target": {"enum": ["gfx1030", "gfx1201"]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewed_sha", "tested_sha", "workflow_sha", "git_tree_oid", "worktree_clean", "revision_input"],
      "properties": {
        "reviewed_sha": {"$ref": "#/$defs/sha40"}, "tested_sha": {"$ref": "#/$defs/sha40"},
        "workflow_sha": {"$ref": "#/$defs/sha40"}, "git_tree_oid": {"$ref": "#/$defs/sha40"},
        "worktree_clean": {"const": true}, "revision_input": {"const": "full-sha"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata_path", "metadata_sha256", "metadata_sidecar_sha256", "artifact_path", "staged_artifact_path", "artifact_sha256", "artifact_sidecar_sha256", "toolchain_manifest_sha256", "matrix_manifest_sha256", "artifact_schema_sha256", "target", "row_id", "h3_executable_used"],
      "properties": {
        "metadata_path": {"type": "string", "pattern": "^/[^\\u0000]*"}, "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "artifact_path": {"type": "string", "pattern": "^/[^\\u0000]*"},
        "staged_artifact_path": {"type": "string", "pattern": "^/[^\\u0000]*"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"}, "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_schema_sha256": {"$ref": "#/$defs/sha256"},
        "target": {"enum": ["gfx1030", "gfx1201"]}, "row_id": {"enum": ["g1-gfx1030", "g1-gfx1201"]},
        "h3_executable_used": {"const": false}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "command_sha256", "exit_code", "timed_out", "crashed", "stdout_sha256", "stderr_sha256", "duration_seconds"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "command_sha256": {"$ref": "#/$defs/sha256"}, "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"}, "crashed": {"type": "boolean"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "runtime_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["rocm_root", "rocm_release", "path", "ld_library_path", "observation_method", "required_libraries", "loaded_libraries", "inherited_loader_environment"],
      "properties": {
        "rocm_root": {"const": "/opt/rocm"},
        "rocm_release": {"const": "7.14.0"},
        "path": {"const": "/opt/rocm/bin:/opt/rocm/lib/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
        "ld_library_path": {"const": "/opt/rocm/lib:/opt/rocm/lib64:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib:/usr/lib"},
        "observation_method": {"const": "proc-pid-maps-poll-v1"},
        "required_libraries": {"const": ["libamdhip64.so.7", "libhsa-runtime64.so.1"]},
        "loaded_libraries": {
          "type": "object", "additionalProperties": false,
          "required": ["libamdhip64.so.7", "libhsa-runtime64.so.1"],
          "properties": {
          "libamdhip64.so.7": {"const": "/opt/rocm/core-7.14/lib/libamdhip64.so.7.14.60850-0000000"},
          "libhsa-runtime64.so.1": {"const": "/opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0"}
          }
        },
        "inherited_loader_environment": {"const": false}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_backend", "fallback_allowed", "fallback_used", "model_used", "semantic_op_used", "byte_exact_verified", "semantic_numerics_verified", "allocation_count", "copy_count", "kernel_dispatch_count", "dispatch_count"],
      "properties": {
        "selected_backend": {"const": "hip"}, "fallback_allowed": {"const": false}, "fallback_used": {"const": false},
        "model_used": {"const": false}, "semantic_op_used": {"const": false}, "byte_exact_verified": {"const": true},
        "semantic_numerics_verified": {"const": false},
        "allocation_count": {"const": 12, "description": "Number of device-memory allocations performed by the six G1 cases; host allocations are not counted."},
        "copy_count": {"const": 12, "description": "Number of HIP transfer operations performed by the six G1 cases; host-only copies are not counted."},
        "kernel_dispatch_count": {"const": 6}, "dispatch_count": {"const": 6}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["size", "state", "byte_exact", "allocation_count", "copy_count", "kernel_dispatch_count", "dispatch_count", "timed_out", "fallback_used"],
      "properties": {
        "size": {"enum": [1, 3, 17, 255, 256, 257]}, "state": {"const": "PASS"},
        "byte_exact": {"const": true},
        "allocation_count": {"const": 2, "description": "Number of device-memory allocations performed by this G1 case; host allocations are not counted."},
        "copy_count": {"const": 2, "description": "Number of HIP transfer operations performed by this G1 case; host-only copies are not counted."},
        "kernel_dispatch_count": {"const": 1}, "dispatch_count": {"const": 1},
        "timed_out": {"type": "boolean"}, "fallback_used": {"const": false}
      }
    },
    "health_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "reliable", "source", "observed_at", "device", "state", "device_state", "runtime_status", "amdgpu_driver_bound", "ras_uncorrectable_count", "temperature_c"],
      "properties": {
        "available": {"const": true}, "reliable": {"const": true}, "source": {"const": "g0-read-only-health-v1"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "device": {"$ref": "#/$defs/device"}, "state": {"const": "OK"}, "device_state": {"const": "active"},
        "runtime_status": {"const": "active"}, "amdgpu_driver_bound": {"const": true},
        "ras_uncorrectable_count": {"type": "integer", "minimum": 0}, "temperature_c": {"type": "number", "minimum": -273.15}
      }
    },
    "process_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "reliable", "source", "observed_at", "device", "state", "gpu_processes", "residual_runner_children"],
      "properties": {
        "available": {"const": true}, "reliable": {"const": true}, "source": {"const": "g0-read-only-process-v1"},
        "observed_at": {"$ref": "#/$defs/timestamp"}, "device": {"$ref": "#/$defs/device"}, "state": {"const": "CLEAN"},
        "gpu_processes": {"const": []}, "residual_runner_children": {"const": []}
      }
    },
    "g1_runtime_matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema_version", "matrix_id", "revision", "tier", "required", "toolchain_id", "execution", "scope", "command", "rows"],
      "properties": {
        "$schema": {"const": "https://sllm-project.local/ci/schema/g1-report-v1.schema.json#/$defs/g1_runtime_matrix"},
        "schema_version": {"const": "g1-runtime-v1"}, "matrix_id": {"const": "g1-runtime-v1"}, "revision": {"const": 1},
        "tier": {"const": "tier_g1"}, "required": {"const": true}, "toolchain_id": {"const": "rocm-7.14.0"},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["serial", "host_lock", "trusted_local_only", "visibility_is_security_boundary", "sudo_allowed", "reset_allowed", "credentials_allowed", "docker_socket_allowed", "binary_is_h3_artifact"],
          "properties": {
            "serial": {"const": true}, "host_lock": {"const": {"path": "/tmp/sllm-g0.lock", "acquisition": "nonblocking"}},
            "trusted_local_only": {"const": true}, "visibility_is_security_boundary": {"const": false}, "sudo_allowed": {"const": false},
            "reset_allowed": {"const": false}, "credentials_allowed": {"const": false}, "docker_socket_allowed": {"const": false},
            "binary_is_h3_artifact": {"const": false}
          }
        },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["model_used", "cpu_fallback_allowed", "semantic_op_used", "byte_exact_verified", "semantic_numerics_verified", "required_sizes"],
          "properties": {
            "model_used": {"const": false}, "cpu_fallback_allowed": {"const": false}, "semantic_op_used": {"const": false},
            "byte_exact_verified": {"const": true}, "semantic_numerics_verified": {"const": false},
            "required_sizes": {"const": [1, 3, 17, 255, 256, 257]}
          }
        },
        "command": {
          "type": "object", "additionalProperties": false,
          "required": ["binary", "arguments", "documentation"],
          "properties": {
            "binary": {"const": "target/release/sllm-hip-evidence"}, "arguments": {"const": ["--timeout-ms", "1000"]},
            "documentation": {"const": "Dedicated Rust evidence binary; compile artifacts are not executable."}
          }
        },
        "rows": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["row_id", "target", "bdf", "uuid", "product", "timeout_seconds", "seed"],
            "properties": {
              "row_id": {"enum": ["g1-gfx1030", "g1-gfx1201"]}, "target": {"enum": ["gfx1030", "gfx1201"]},
              "bdf": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"},
              "uuid": {"type": "string", "pattern": "^GPU-[0-9a-f]{16}$"}, "product": {"type": "string", "minLength": 1},
              "timeout_seconds": {"type": "integer", "minimum": 1}, "seed": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "required": ["schema_version", "report_id", "row_id", "target", "state", "required", "run_id", "run_attempt", "candidate", "artifact", "execution", "runtime_binding", "scope", "device", "created_at", "started_at", "finished_at", "duration_seconds", "health_pre", "health_post", "process_pre", "process_post", "cases", "error"],
  "properties": {
    "schema_version": {"const": "g1-report-v1"}, "report_id": {"type": "string", "minLength": 1},
    "row_id": {"enum": ["g1-gfx1030", "g1-gfx1201"]}, "target": {"enum": ["gfx1030", "gfx1201"]},
    "state": {"const": "PASS"}, "required": {"const": true},
    "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1},
    "candidate": {"$ref": "#/$defs/candidate"}, "artifact": {"$ref": "#/$defs/artifact"},
    "execution": {"$ref": "#/$defs/execution"}, "scope": {"$ref": "#/$defs/scope"},
    "runtime_binding": {"$ref": "#/$defs/runtime_binding"},
    "device": {"$ref": "#/$defs/device"}, "created_at": {"$ref": "#/$defs/timestamp"},
    "started_at": {"$ref": "#/$defs/timestamp"}, "finished_at": {"$ref": "#/$defs/timestamp"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "health_pre": {"$ref": "#/$defs/health_observation"}, "health_post": {"$ref": "#/$defs/health_observation"},
    "process_pre": {"$ref": "#/$defs/process_observation"}, "process_post": {"$ref": "#/$defs/process_observation"},
    "cases": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 3}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 17}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 255}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 256}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"size": {"const": 257}}}]}
      ],
      "items": false
    },
    "error": {"const": null}
  }
}
