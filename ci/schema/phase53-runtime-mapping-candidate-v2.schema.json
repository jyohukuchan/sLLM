{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sllm.dev/schema/phase53-runtime-mapping-candidate-v2.schema.json",
  "title": "sLLM Phase 53 non-authoritative revised-recipe runtime mapping candidate",
  "type": "object", "additionalProperties": false,
