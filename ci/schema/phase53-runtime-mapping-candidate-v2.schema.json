    "policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "safety_default": {"const": "fp16"},
    "promotion_scope": {"const": "first-promotion-qwen35-4b-bf16-dense-text-full-attention-single-gpu"},
    "mappings": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["target", "encoding", "descriptor_id", "scale_recipe", "model_lock_fingerprint"], "properties": {"target": {"enum": ["gfx942:sramecc+:xnack-", "gfx1201", "gfx1030"]}, "encoding": {"enum": ["kv-fp8-e4-block16", "kv-fp8-e5-block16"]}, "descriptor_id": {"enum": ["kv-fp8-e4-block16-v2", "kv-fp8-e5-block16-v2"]}, "scale_recipe": {"const": "standard-mx-floor-power-v1"}, "model_lock_fingerprint": {"const": "sha256:f143d7b504170d071c77818105f7a07dc0297c6bea0c61a5404b071fed0c1fae"}}}}
  },
  "allOf": [
    {"properties": {"mappings": {"items": {"allOf": [
      {"if": {"properties": {"target": {"enum": ["gfx942:sramecc+:xnack-", "gfx1201"]}}}, "then": {"properties": {"encoding": {"const": "kv-fp8-e4-block16"}, "descriptor_id": {"const": "kv-fp8-e4-block16-v2"}}}},
      {"if": {"properties": {"target": {"const": "gfx1030"}}}, "then": {"properties": {"encoding": {"const": "kv-fp8-e5-block16"}, "descriptor_id": {"const": "kv-fp8-e5-block16-v2"}}}}
    ]}}}}
  ]
}
