{
  "schema_version": "path-to-suite-v1",
  "revision": 3,
  "default_suite_ids": ["h0-tracked-tree", "h0-suite-registration"],
  "rules": [
    {"pattern": "ci/**", "suite_ids": ["h0-rust-format", "h0-rust-clippy", "h0-cpp-format-static", "h0-python", "h0-markdown-links", "h0-json-schema-manifest-workflow", "h0-license-provenance", "h0-tracked-tree", "h0-suite-registration", "h0-self-test", "h1-host-contract", "h2-tiny-oracle"]},
    {"pattern": ".github/**", "suite_ids": ["h0-json-schema-manifest-workflow", "h0-markdown-links"]},
    {"pattern": "Cargo.toml", "suite_ids": ["h0-rust-format", "h0-rust-clippy", "h1-host-contract"]},
    {"pattern": "Cargo.lock", "suite_ids": ["h0-rust-format", "h0-rust-clippy", "h1-host-contract"]},
    {"pattern": "crates/**", "suite_ids": ["h0-rust-format", "h0-rust-clippy", "h1-host-contract"]},
    {"pattern": "native/**", "suite_ids": ["h0-cpp-format-static", "h1-host-contract"]},
    {"pattern": "include/**", "suite_ids": ["h0-cpp-format-static", "h1-host-contract"]},
    {"pattern": "tests/api/**", "suite_ids": ["h0-python", "h1-host-contract"]},
    {"pattern": "tests/contracts/**", "suite_ids": ["h0-python", "h1-host-contract"]},
    {"pattern": "tests/reference/**", "suite_ids": ["h0-python", "h2-tiny-oracle"]},
    {"pattern": "tests/fixtures/api_cases.json", "suite_ids": ["h0-python", "h1-host-contract"]},
    {"pattern": "tests/fixtures/boundary_cases.json", "suite_ids": ["h0-python", "h2-tiny-oracle"]},
    {"pattern": "tests/fixtures/kv_layout.json", "suite_ids": ["h0-python", "h2-tiny-oracle"]},
    {"pattern": "tests/fixtures/sampling_cases.json", "suite_ids": ["h0-python", "h2-tiny-oracle"]},
    {"pattern": "tests/**", "suite_ids": ["h0-python"]},
    {"pattern": "pyproject.toml", "suite_ids": ["h0-python", "h1-host-contract", "h2-tiny-oracle"]},
    {"pattern": "**/*.rs", "suite_ids": ["h0-rust-format", "h0-rust-clippy", "h1-host-contract"]},
    {"pattern": "**/*.cpp", "suite_ids": ["h0-cpp-format-static", "h1-host-contract"]},
    {"pattern": "**/*.hpp", "suite_ids": ["h0-cpp-format-static", "h1-host-contract"]},
    {"pattern": "**/*.h", "suite_ids": ["h0-cpp-format-static", "h1-host-contract"]},
    {"pattern": "**/*.py", "suite_ids": ["h0-python"]},
    {"pattern": "**/*.md", "suite_ids": ["h0-markdown-links"]},
    {"pattern": "LICENSE*", "suite_ids": ["h0-license-provenance"]},
    {"pattern": "docs/provenance/**", "suite_ids": ["h0-license-provenance"]},
    {"pattern": "docs/references/**", "suite_ids": ["h0-license-provenance"]}
  ]
}
