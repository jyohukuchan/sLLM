    size_t cols,
    size_t batch_count) {
    if (device_index == 0u) {
        return ULLM_AQ4_MATVEC_BATCH_DISPATCH_LEGACY;
    }
    const Aq4MatvecBatchDispatchKind kind = aq4_matvec_batch_dispatch_kind_for_device(
        static_cast<int>(device_index - 1u),
        group_size,
        rows,
        cols,
        batch_count);
