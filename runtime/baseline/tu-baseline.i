    }
    __syncthreads();

    float block_sum = 0.0f;
    const unsigned int wave_count = (blockDim.x + warpSize - 1u) / warpSize;
    if (wave == 0) {
        block_sum = lane < wave_count ? partial[lane] : 0.0f;
        for (int offset = warpSize >> 1; offset > 0; offset >>= 1) {
