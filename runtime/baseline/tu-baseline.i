        k_cache_buffer,
        v_cache_buffer,
        block_table_buffer,
        k_scale_buffer,
        v_scale_buffer,
        cache_len,
        block_size,
        cache_blocks,
        q_heads,
        kv_heads,
        head_dim,
        value_dim,
        softmax_scale,
        k_dtype,
        v_dtype,
        q_bytes,
        k_bytes,
        v_bytes,
        table_bytes,
        k_scale_buffer == nullptr ? 0u : scale_bytes,
        v_scale_buffer == nullptr ? 0u : scale_bytes,
        output_bytes,
        output_buffer,
        stream);
    if (staged != ULLM_STATUS_OK || gate_buffer == nullptr) {
        return staged;
    }
    return ullm_runtime_sigmoid_mul_f32(
        gate_buffer, output_buffer, output_values, output_buffer, stream);
}
