    if (tid < kUllmSq8_1WaveSize) {
        const float block_sum = tid < kUllmSq8_1RowsPerBlock ? wave_sums[tid] : 0.0f;
        const float final_sum = ullm_sq8_1_wave32_sum(block_sum);
        if (tid == 0u && row < rows) {
            output[row] = final_sum;
        }
    }
}
)";
