        set_error(hip_kernel_error.empty() ? "f32 causal attention HIP kernel is unavailable" : hip_kernel_error.c_str());
        return ULLM_STATUS_RUNTIME_ERROR;
    }
    return causal_attn_f32_hip_staging(
        q_buffer,
        k_buffer,
        v_buffer,
        sequence_len,
        q_heads,
        kv_heads,
        head_dim,
        value_dim,
        softmax_scale,
        q_bytes,
        k_bytes,
        v_bytes,
        output_bytes,
        output_buffer,
        stream);
