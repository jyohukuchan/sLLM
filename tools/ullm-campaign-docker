#!/usr/bin/python3.12 -I
"""Inject the transaction-owned lease label into every Docker container create."""

from __future__ import annotations

import os
import re
import sys
from collections.abc import Mapping, Sequence


sys.dont_write_bytecode = True


REAL_DOCKER = "/usr/bin/docker"
LEASE_ENVIRONMENT = "ULLM_CAMPAIGN_DOCKER_LEASE_LABEL"
LEASE_LABEL_KEY = "com.ultimatellm.served-model-campaign.claim"
LEASE_RE = re.compile(
    rf"{re.escape(LEASE_LABEL_KEY)}=[0-9a-f]{{64}}\Z"
)
RESERVED_LABEL_OPTIONS = frozenset(
    {
        "-l",
        "--label",
        "--label-file",
    }
)
CLUSTERABLE_BOOLEAN_SHORT_OPTIONS = frozenset({"d", "i", "t", "P"})


class DockerLeaseWrapperError(ValueError):
    """The Docker invocation could escape the transaction lease."""


def _lease(environment: Mapping[str, str]) -> str:
    lease = environment.get(LEASE_ENVIRONMENT)
    if not isinstance(lease, str) or LEASE_RE.fullmatch(lease) is None:
        raise DockerLeaseWrapperError("campaign Docker lease label is unavailable")
    return lease


def _reject_reserved_labels(arguments: Sequence[str]) -> None:
    for argument in arguments:
        short_label = False
        if argument.startswith("-") and not argument.startswith("--"):
            for option in argument[1:]:
                if option == "l":
                    short_label = True
                    break
                if option not in CLUSTERABLE_BOOLEAN_SHORT_OPTIONS:
                    break
        if (
            short_label
            or argument in RESERVED_LABEL_OPTIONS
            or argument.startswith("--label=")
            or argument.startswith("--label-file=")
            or argument.startswith("-l=")
        ):
            raise DockerLeaseWrapperError(
                "caller-provided Docker labels are not permitted"
            )


def rewrite_arguments(
    arguments: Sequence[str],
    environment: Mapping[str, str],
) -> tuple[str, ...]:
    if (
        not arguments
        or any(
            not isinstance(argument, str)
            or not argument
            or "\x00" in argument
            for argument in arguments
        )
    ):
        raise DockerLeaseWrapperError("Docker argument vector is invalid")
    lease = _lease(environment)
    command = tuple(arguments)
    if command[0].startswith("-"):
        raise DockerLeaseWrapperError("Docker global options are not permitted")
    if command[0] in {"run", "create"}:
        _reject_reserved_labels(command[1:])
        return (
            REAL_DOCKER,
            command[0],
            f"--label={lease}",
            *command[1:],
        )
    if len(command) >= 2 and command[:2] in {
        ("container", "run"),
        ("container", "create"),
    }:
        _reject_reserved_labels(command[2:])
        return (
            REAL_DOCKER,
            *command[:2],
            f"--label={lease}",
            *command[2:],
        )
    return (REAL_DOCKER, *command)


def main(argv: Sequence[str] | None = None) -> int:
    selected = tuple(sys.argv[1:] if argv is None else argv)
    try:
        rewritten = rewrite_arguments(selected, os.environ)
    except DockerLeaseWrapperError:
        return 125
    os.execve(REAL_DOCKER, list(rewritten), dict(os.environ))
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
